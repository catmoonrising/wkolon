"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["4th\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":["Command Cover +2, ",{"tag":"a","children":["Crime Lord Talent"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},"\n"]},"\n",{"tag":"td","children":["9th\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Crime Lord Talent"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["5th\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Crime Lord Talent"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},"\n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":["Command Cover +5, ",{"tag":"a","children":["Crime Lord Talent"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},"\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Crime Lords gain a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", and a +4 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Crime Lords gain 1d8 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Crime Lords gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, each time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At 1st level and each level thereafter, a Crime Lord gains an additional ",{"tag":"a","children":["Crime Lord Talent"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent"},". A Crime Lord may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Crime Lord Talent Trees"],"href":"https://swse.miraheze.org/wiki/Crime_Lord_Talent_Trees","referenceId":"reference:500d13611a818007"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Command Cover"]},"\n",{"tag":"p","children":["Starting at 2nd level, a Crime Lord can use their allies to shield them from harm. You can gain a +1 ",{"tag":"a","children":["Cover"],"href":"https://swse.miraheze.org/wiki/Cover"}," bonus to your ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," for each ally that is adjacent to you, up to a maximum bonus equal to one-half your Class Level (maximum +5 at 10th level).\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
