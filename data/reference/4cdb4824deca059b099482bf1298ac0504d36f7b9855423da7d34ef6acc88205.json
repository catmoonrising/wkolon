:"td","children":["As an explorer of dangerous places, you are trained to react to danger swiftly and adroitly, as well as navigate ",{"tag":"a","children":["Difficult Terrain"],"href":"https://swse.miraheze.org/wiki/Difficult_Terrain"}," and reduce damage.\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Core Rulebook"],"href":"https://swse.miraheze.org/wiki/Core_Rulebook"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Enforcement Talent Tree"],"href":"https://swse.miraheze.org/wiki/Enforcement_Talent_Tree","referenceId":"reference:0ac6d6b952da8cf5"},"\n"]},"\n",{"tag":"td","children":["You are a trained investigator who can locate and apprehend a quarry with exceptional speed and prowess.\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Force Unleashed Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Force_Unleashed_Campaign_Guide"}]},"\n"]}]}]}]},"\n","\n","\n","\n\n","\n\n","\n"]}}
