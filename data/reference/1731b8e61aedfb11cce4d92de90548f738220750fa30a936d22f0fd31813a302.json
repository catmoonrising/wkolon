hildren":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"},", ",{"tag":"a","children":["Survival"],"href":"https://swse.miraheze.org/wiki/Survival","referenceId":"reference:8302496de0ace160"},", ",{"tag":"a","children":["Swim"],"href":"https://swse.miraheze.org/wiki/Swim","referenceId":"reference:dd4fa375c70c4e42"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Soldier"],"href":"https://swse.miraheze.org/wiki/Soldier","referenceId":"reference:f826baa05bef6921"},"\n"]},"\n",{"tag":"td","children":["3 + Int Modifier\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Climb"],"href":"https://swse.miraheze.org/wiki/Climb","referenceId":"reference:98ca5f27d9642dc7"},", ",{"tag":"a","children":["Endurance"],"href":"https://swse.miraheze.org/wiki/Endurance","referenceId":"reference:98c8abf84e23ff3f"},", ",{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},", ",{"tag":"a","children":["Jump"],"href":"https://swse.miraheze.org/wiki/Jump","referenceId":"reference:9ee0ca3e24d60ea0"},", ",{"tag":"a","children":["Knowledge (Tactics)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Tactics)"},", ",{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"},", ",{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"},", ",{"tag":"a","children":["Swim"],"href":"https://swse.miraheze.org/wiki/Swim","referenceId":"reference:dd4fa375c70c4e42"},", ",{"tag":"a","children":["Treat Injury"],"href":"https://swse.miraheze.org/wiki/Treat_Injury","referenceId":"reference:f1b9875c2302ce61"},", ",{"tag":"a","children":["Use Computer"],"href":"https://swse.miraheze.org/wiki/Use_Computer","referenceId":"reference:ff8449006aafd27d"},"\n"]}]}]}]},"\n",{"tag":"p","children":["Put another way, a character's ",{"tag":"a","children":["Trained Skills"],"href":"https://swse.miraheze.org/wiki/Trained_Skills"}," represent a subset of that character's Class Skills. Every time a character picks up a new ",{"tag":"a","children":["Heroic Class"],"href":"https://swse.miraheze.org/wiki/Heroic_Class"},", their list of Class Skills grows to include those of the new class, but the only way to gain new ",{"tag":"a","children":["Trained Skills"],"href":"https://swse.miraheze.org/wiki/Trained_Skills"}," after 1st level is to take the ",{"tag":"a","children":["Skill Training"],"href":"https://swse.miraheze.org/wiki/Skill_Training","referenceId":"reference:fa24e9bf050e743e"}," feat or to increase a character's ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"},". For example, a ",{"tag":"a","children":["Noble"],"href":"https://swse.miraheze.org/wiki/Noble","referenceId":"reference:190d375ec3483f8f"}," gets 6 ",{"tag":"a","children":["Trained Skills"],"href":"https://swse.miraheze.org/wiki/Trained_Skills"}," at 1st level. If they have a +1 ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," modifier, their total becomes 7 ",{"tag":"a","children":["Trained Skills"],"href":"https://swse.miraheze.org/wiki/Trained_Skills"},". The ",{"tag":"a","children":["Noble"],"href":"https://swse.miraheze.org/wiki/Noble","referenceId":"reference:190d375ec3483f8f"}," then selects 7 ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," from their list of Class Skills, which then become ",{"tag":"a","children":["Trained Skills"],"href":"https://swse.miraheze.org/wiki/Trained_Skills"}," for them.\n"]},{"tag":"p","children":[{"tag":"a","children":["Nonheroic"],"href":"https://swse.miraheze.org/wiki/Nonheroic","referenceId":"reference:1bca2ef1d9ebe1c3"}," characters treat all ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," except ",{"tag":"a","children":["Use the Force"],"href":"https://swse.miraheze.org/wiki/Use_the_Force","referenceId":"reference:74883d1dd46b87fe"}," as Class Skills. The Class Skills of Beast characters include ",{"tag":"a","children":["Acrobatics"],"href":"https://swse.miraheze.org/wiki/Acrobatics","referenceId":"reference:0d0b7eee2953750e"},", ",{"tag":"a","children":["Climb"],"href":"https://swse.miraheze.org/wiki/Climb","referenceId":"reference:98ca5f27d9642dc7"},", ",{"tag":"a","children":["Endurance"],"href":"https://swse.miraheze.org/wiki/Endurance","referenceId":"reference:98c8abf84e23ff3f"},", ",{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},", ",{"tag":"a","children":["Jump"],"href":"https://swse.miraheze.org/wiki/Jump","referenceId":"reference:9ee0ca3e24d60ea0"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"},", ",{"tag":"a","children":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"},", ",{"tag":"a","children":["Survival"],"href":"https://swse.miraheze.org/wiki/Survival","referenceId":"reference:8302496de0ace160"},", and ",{"tag":"a","children":["Swim"],"href":"https://swse.miraheze.org/wiki/Swim","referenceId":"reference:dd4fa375c70c4e42"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
