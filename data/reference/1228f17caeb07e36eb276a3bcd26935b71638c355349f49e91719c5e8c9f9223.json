ldren":[{"tag":"b","children":["Government:"]}," Imperial Governor\n"]},{"tag":"p","children":[{"tag":"b","children":["Capital:"]}," Kway Teow\n"]},{"tag":"p","children":[{"tag":"b","children":["Major Exports:"]}," Slaves, Biotoxins, Medicine\n"]},{"tag":"p","children":[{"tag":"b","children":["Major Imports:"]}," High-Tech Goods, Foodstuffs\n"]},"\n",{"tag":"h4","children":["Galactic Lore"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["DC\n"]},"\n",{"tag":"th","children":["RESULT\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["During ",{"tag":"a","children":["The Clone Wars"],"href":"https://swse.miraheze.org/wiki/The_Clone_Wars"},", Felucia was a major stronghold for the Separatists, particularly the Commerce Guild.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["Since their defeat, Separatist remnants, including the planet's ",{"tag":"a","children":["Gossam"],"href":"https://swse.miraheze.org/wiki/Gossam?action=edit&redlink=1"}," settlers, have taken shelter in small enclaves in the fungal wilderness, joining forces with the fugitive laborers, outlaws, and smugglers they formerly persecuted.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["Imperial forces maintain a presence in Kway Teow primarily to gather ",{"tag":"a","children":["Gossam"],"href":"https://swse.miraheze.org/wiki/Gossam?action=edit&redlink=1"}," slaves for export and to research biological agents taken from the diverse and abundant plant life.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":["During ",{"tag":"a","children":["The Dark Times"],"href":"https://swse.miraheze.org/wiki/The_Dark_Times"},", the Jedi ",{"tag":"a","children":["Shaak Ti"],"href":"https://swse.miraheze.org/wiki/Shaak_Ti","referenceId":"r