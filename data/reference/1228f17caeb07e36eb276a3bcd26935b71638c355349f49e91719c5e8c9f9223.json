iki/Bull_Rancor","referenceId":"reference:42d38780e590a875"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":["The native ",{"tag":"a","children":["Felucians"],"href":"https://swse.miraheze.org/wiki/Felucians"}," have a degree of Force-sensitivity that primarily manifests itself through tribal shamans (see ",{"tag":"a","children":["The Felucian Shamans"],"href":"https://swse.miraheze.org/wiki/The_Felucian_Shamans","referenceId":"reference:3f5a6e0e902bd292"},").\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["30\n"]},"\n",{"tag":"td","children":["The Jedi apprentice ",{"tag":"a","children":["Maris Brood"],"href":"https://swse.miraheze.org/wiki/Maris_Brood","referenceId":"reference:a7f19b4f7e4dd5c5"},", after hiding on Felucia and turning to the ",{"tag":"a","children":["Dark Side"],"href":"https://swse.miraheze.org/wiki/Dark_Side"},", corrupts several Felucian Shamans and trains them to tap into the more sinister aspects of ",{"tag":"a","children":["the Force"],"href":"https://swse.miraheze.org/wiki/The_Force","referenceId":"reference:67fe90e919b74d0f"},".\n"]}]}]}]},"\n","\n","\n","\n","\n\n","\n\n","\n"]}}
