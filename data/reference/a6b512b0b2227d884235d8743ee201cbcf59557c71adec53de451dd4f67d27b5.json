reature until the start of the attacker's next turn. ",{"tag":"a","children":["Blind"],"href":"https://swse.miraheze.org/wiki/Blind"}," creatures are immune to this effect.\n"]},{"tag":"p","children":[{"tag":"b","children":["Weapon Type:"]}," ",{"tag":"a","children":["Grenades"],"href":"https://swse.miraheze.org/wiki/Grenades","referenceId":"reference:0288f85b407ca487"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Size:"]}," Tiny\n"]},{"tag":"p","children":[{"tag":"b","children":["Cost:"]}," 100\n"]},{"tag":"p","children":[{"tag":"b","children":["Damage:"]}," -\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Burst"],"href":"https://swse.miraheze.org/wiki/Burst"}," Radius:"]}," 3-Squares\n"]},{"tag":"p","children":[{"tag":"b","children":["Weight:"]}," 0.5 Kilograms\n"]},{"tag":"p","children":[{"tag":"b","children":["Type:"]}," Energy\n"]},{"tag":"p","children":[{"tag":"b","children":["Availability:"]}," ",{"tag":"a","children":["Restricted"],"href":"https://swse.miraheze.org/wiki/Restricted"},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
