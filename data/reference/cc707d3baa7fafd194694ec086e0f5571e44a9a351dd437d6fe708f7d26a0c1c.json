dren":["Shaper Lore (+2)\n"]},"\n",{"tag":"td","children":["9th\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Shaper Talent"],"href":"https://swse.miraheze.org/wiki/Shaper_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["5th\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Shaper Talent"],"href":"https://swse.miraheze.org/wiki/Shaper_Talent"},"\n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":["Shaper Lore (+5)\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Shapers gain a +4 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},", and a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Shapers gain 1d8 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Shapers, like all ",{"tag":"a","children":["Yuuzhan Vong"],"href":"https://swse.miraheze.org/wiki/Yuuzhan_Vong","referenceId":"reference:93079e2f7d73d480"},", never gain ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Shaper gains an additional ",{"tag":"a","children":["Shaper Talent"],"href":"https://swse.miraheze.org/wiki/Shaper_Talent"},". A Shaper may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Shaper Talent Trees"],"href":"https://swse.miraheze.org/wiki/Shaper_Talent_Trees","referenceId":"reference:83aa436b602f95a3"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Shaper Lore"]},"\n",{"tag":"p","children":["A Shaper is skilled at building, modifying, and repairing ",{"tag":"a","children":["Biotechnology"],"href":"https://swse.miraheze.org/wiki/Biotechnology"},". Because of this intimate familiarity, a Shaper gains a bonus equal to one-half their Class Level (rounded down) on all ",{"tag":"a","children":["Knowledge (Life Sciences)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Life_Sciences)"}," and ",{"tag":"a","children":["Treat Injury"],"href":"https://swse.miraheze.org/wiki/Treat_Injury","referenceId":"reference:f1b9875c2302ce61"}," checks made with regards to ",{"tag":"a","children":["Biotech"],"href":"https://swse.miraheze.org/wiki/Biotech"},", regardless of size or complexity.\n"]},"\n",{"tag":"h3","children":["Shaper Hand"]},"\n",{"tag":"p","children":["At 6th level, a ",{"tag":"a","children":["Yuuzhan Vong"],"href":"https://swse.miraheze.org/wiki/Yuuzhan_Vong","referenceId":"reference:93079e2f7d73d480"}," Shaper is expected to replace at least one of their hands with what is known as a Shaper Hand. A Shaper Hand is a bioengineered appendage equipped with a number of tools that assist in tasks specific to Shaping. A Shaper who declines to attach a Shaper Hand when permitted to do so is often viewed with suspicion by other ",{"tag":"a","children":["Yuuzhan Vong"],"href":"https://swse.miraheze.org/wiki/Yuuzhan_Vong","referenceId":"reference:93079e2f7d73d480"},".\n"]},{"tag":"p","children":["A Shaper Hand replaces the need for a ",{"tag":"a","children":["Biotech Tool Kit"],"href":"https://swse.miraheze.org/wiki/Biotech_Tool_Kit","referenceId":"reference:44ab65e7f988e365"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
