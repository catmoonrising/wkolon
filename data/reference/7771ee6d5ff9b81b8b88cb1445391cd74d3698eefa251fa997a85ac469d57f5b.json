e.org/wiki/Repair"}," or modify a WLO-5 Speeder Tank automatically gains a +5 ",{"tag":"a","children":["Equipment"],"href":"https://swse.miraheze.org/wiki/Equipment","referenceId":"reference:7f2465ac7cefab27"}," bonus to ",{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"}," checks to perform that action.\n"]},{"tag":"p","children":["The ",{"tag":"a","children":["Weequay"],"href":"https://swse.miraheze.org/wiki/Weequay","referenceId":"reference:0e0d4641bbf2dd91"}," pirates under the command of ",{"tag":"a","children":["Hondo Ohnaka"],"href":"https://swse.miraheze.org/wiki/Hondo_Ohnaka","referenceId":"reference:d07b41461e618bcc"}," use WLO-5 Speeder Tanks, modifying them to include a pair of antipersonnel ",{"tag":"a","children":["Laser Cannons"],"href":"https://swse.miraheze.org/wiki/Laser_Cannons"}," in addition to their normal armament (",{"tag":"b","children":[{"tag":"a","children":["Laser Cannons"],"href":"https://swse.miraheze.org/wiki/Laser_Cannons"},":"]}," +6 (+1 ",{"tag":"a","children":["Autofire"],"href":"https://swse.miraheze.org/wiki/Autofire"},") (5d10)).\n"]},"\n",{"tag":"h4","children":["Default (Skilled)"]},"\n",{"tag":"h2","children":["WLO-5 Speeder Tank Statistics (CL 6)"]},"\n",{"tag":"p","children":["Gargantuan ",{"tag":"a","children":["Speeder"],"href":"https://swse.miraheze.org/wiki/Speeder"},"\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +3; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +6\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 15 (",{"tag":"a","children":["Flat-