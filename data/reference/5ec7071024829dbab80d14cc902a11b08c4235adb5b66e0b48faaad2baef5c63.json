at War"],"href":"https://swse.miraheze.org/wiki/Galaxy_at_War"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Multispectrum Searchlight"],"href":"https://swse.miraheze.org/wiki/Multispectrum_Searchlight","referenceId":"reference:750e3fbfd9555e8e"},"\n"]},"\n",{"tag":"td","children":["4,000 Squares\n"]},"\n",{"tag":"td","children":["\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Scavenger's Guide to Droids"],"href":"https://swse.miraheze.org/wiki/Scavenger%27s_Guide_to_Droids"}]},"\n"]}]}]}]},"\n",{"tag":"p","children":[{"tag":"i","children":["*Creates a beam 6 squares long, and 1 square high."]},"\n"]},"\n",{"tag":"h2","children":["Blindness"]},"\n",{"tag":"p","children":["A Blinded creature can't see and takes a -2 penalty to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", loses its ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," (if any), moves at half ",{"tag":"a","children":["Speed"],"href":"https://swse.miraheze.org/wiki/Speed","referenceId":"reference:c372fee9b4566b85"},", and takes a -5 penalty on ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," checks. All opponents are considered to have ",{"tag":"a","children":["Total Concealment"],"href":"https://swse.miraheze.org/wiki/Total_Concealment"}," to the Blinded creature. All checks and actions that rely on vision (such as reading) fail automatically.\n"]},"\n",{"tag":"h2","children":["Low-Light Vision"]},"\n",{"tag":"p","children":["A creature or ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," that has Low-Light Vision can see without penalty in shadowy illumination, ignoring ",{"tag":"a","children":["Concealment"],"href":"https://swse.miraheze.org/wiki/Concealment"}," (but not ",{"tag":"a","children":["Total Concealment"],"href":"https://swse.miraheze.org/wiki/Total_Concealment"},") due to darkness. It retains the ability to distinguish color and detail under these conditions.\n"]},"\n",{"tag":"h3","children":["Darkvision"]},"\n",{"tag":"p","children":["A creature or ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," that has Darkvision can see in the dark, ignoring ",{"tag":"a","children":["Concealment"],"href":"https://swse.miraheze.org/wiki/Concealment"}," and ",{"tag":"a","children":["Total Concealment"],"href":"https://swse.miraheze.org/wiki/Total_Concealment"}," due to darkness. Darkvision is black and white only, so there must be at least some light to discern colors. It is otherwise like normal sight, and a creature with Darkvision can function with no light at all.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
