ht Armor"],"href":"https://swse.miraheze.org/wiki/Light_Armor","referenceId":"reference:1b329ddc8a34adfe"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Cost:"]}," 8,000\n"]},{"tag":"p","children":[{"tag":"b","children":["Bonus to ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},":"]}," +6\n"]},{"tag":"p","children":[{"tag":"b","children":["Bonus to ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},":"]}," +2\n"]},{"tag":"p","children":[{"tag":"b","children":["Maximum ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"}," Bonus:"]}," +3\n"]},{"tag":"p","children":[{"tag":"b","children":["Weight:"]}," 10 Kilograms\n"]},{"tag":"p","children":[{"tag":"b","children":["Availability:"]}," ",{"tag":"a","children":["Military"],"href":"https://swse.miraheze.org/wiki/Military"},", ",{"tag":"a","children":["Rare"],"href":"https://swse.miraheze.org/wiki/Rare"},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
