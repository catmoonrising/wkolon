tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Dual-Phase Lightsaber"],"href":"https://swse.miraheze.org/wiki/Dual-Phase_Lightsaber","referenceId":"reference:d1cba828014fc983"},"\n"]},"\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Dueling Lightsaber"],"href":"https://swse.miraheze.org/wiki/Dueling_Lightsaber","referenceId":"reference:74dc52a27cfaa2ea"},"\n"]},"\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Great Lightsaber"],"href":"https://swse.miraheze.org/wiki/Great_Lightsaber","referenceId":"reference:7039ff9d78a5631a"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Guard Shoto"],"href":"https://swse.miraheze.org/wiki/Guard_Shoto","referenceId":"reference:5486e6d2b62d6be9"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Lightsaber Pike"],"href":"https://swse.miraheze.org/wiki/Lightsaber_Pike","referenceId":"reference:51f185b785dd1bd5"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Lightwhip"],"href":"https://swse.miraheze.org/wiki/Lightwhip","referenceId":"reference:195da5c178521fb8"},"\n"]},"\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Long-Handle Lightsaber"],"href":"https://swse.miraheze.org/wiki/Long-Handle_Lightsaber","referenceId":"reference:bd1d2562b984c249"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Modern Lightfoil"],"href":"https://swse.miraheze.org/wiki/Modern_Lightfoil","referenceId":"reference:18d214c9f6fa3326"},"\n"]},"\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Retrosaber"],"href":"https://swse.miraheze.org/wiki/Retrosaber","referenceId":"reference:e1a5736b1a0c920e"},"\n"]},"\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]}]}]}]},"\n",{"tag":"h4","children":["Lightsaber Crystals"]},"\n",{"tag":"p","children":["One of the most critical elements in a Lightsaber's construction is its Lightsaber Crystal. These Crystals come from a variety of sources, but in the end they are a crucial part of the mechanism that creates and focuses the ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," blade. It is to the Lightsaber Crystal that a ",{"tag":"a","children":["Jedi"],"href":"https://swse.miraheze.org/wiki/Jedi","referenceId":"reference:0b0e48747027a29d"}," attunes themselves, giving them the benefit of the Lightsaber Crystal's bond. Lightsaber Crystals come in many varieties, and the Lightsaber Crystal determines not only the Lightsaber blade's color, but also the blade's special properties. Some Lightsaber Crystals modify the Build DC of ",{"tag":"a","children":["Lightsabers"],"href":"https://swse.miraheze.org/wiki/Lightsabers","referenceId":"reference:420c60d0a682943a"},", representing how easy of difficult it is to incorporate the Lightsaber Crystal into the weapon's design. Available Lightsaber Crystals are described in the table below.\n"]},{"tag":"p","children":["The standard benefit for creating a Lightsaber an ",{"tag":"a","children":["Adegan Crystal"],"href":"https://swse.miraheze.org/wiki/Adegan_Crystal"},", ",{"tag":"a","children":["Ilum Crystal"],"href":"https://swse.miraheze.org/wiki/Ilum_Crystal","referenceId":"reference:d330f9b088faed5d"},", or ",{"tag":"a","children":["Synthetic Crystal"],"href":"https://swse.miraheze.org/wiki/Synthetic_Crystal"}," is a +1 untyped bonus on attack rolls with that weapon. This bonus is granted only to the person attuned to the Lightsaber, and only the person that built the Lightsaber can be attuned to it. Some Lightsaber Crystals provide other benefits instead of the +1 bonus on attack rolls.\n"]},{"tag":"p","children":["Like the standard benefit, these benefits from the Lightsaber Crystals apply only to the person who created the ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," (provided he or she is attuned to the blade). If a character who is not attuned to the weapon wields it, the weapon still does normal damage and otherwise functions as normal; the person does not receive the benefits of the Lightsaber Crystal. The exception to this rule are Lightsaber Crystals that change the weapon's damage type or damage dice, like a ",{"tag":"a","children":["Barab Ingot"],"href":"https://swse.miraheze.org/wiki/Barab_Ingot","referenceId":"reference:e410d51f92da0de7"},", ",{"tag":"a","children":["Bondar Crystal"],"href":"https://swse.miraheze.org/wiki/Bondar_Crystal","referenceId":"reference:1c775656c4b7d7d1"},", or ",{"tag":"a","children":["Firkraan Crystal"],"href":"https://swse.miraheze.org/wiki/Firkraan_Crystal","referenceId":"reference:be99866418ad9efc"},"; this effect applies to the Lightsaber's damage no matter who wields it. A Lightsaber Crystal's description tells you what the bonus is for wielding attuned ",{"tag":"a","children":["Lightsabers"],"href":"https://swse.miraheze.org/wiki/Lightsabers","referenceId":"reference:420c60d0a682943a"}," with a particular Lightsaber Crystal.\n"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["CRYSTAL\n"]},"\n",{"tag":"th","children":["TYPE\n"]},"\n",{"tag":"th","children":["COLOR\n"]},"\n",{"tag":"th","children":["DC MODIFIER\n"]},"\n",{"tag":"th","children":["EFFECT\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Ankarres Sapphire"],"href":"https://swse.miraheze.org/wiki/Ankarres_Sapphire","referenceId":"reference:f5a20452b5f9c5bf"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Rare Crystals"],"href":"https://swse.miraheze.org/wiki/Rare_Crystals"},"\n"]},"\n",{"tag":"td","children":["Blue\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":["Improves one's healing ability while wielding the Lightsaber.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Barab Ingot"],"href":"https://swse.miraheze.org/wiki/Barab_Ingot","referenceId":"reference:e410d51f92da0de7"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Rare Crystals"],"href":"https://swse.miraheze.org/wiki/Rare_Crystals"},"\n"]},"\n",{"tag":"td","children":["Varies\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":["Lightsaber deals ",{"tag":"a","children":["Fire"],"href":"https://swse.miraheze.org/wiki/Fire","referenceId":"reference:c141faa80e43a119"}," damage instead of normal damage.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Bondar Crystal"],"href":"https://swse.miraheze.org/wiki/Bondar_Crystal","referenceId":"reference:1c775656c4b7d7d1"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Traditional Jewels"],"href":"https://swse.miraheze.org/wiki/Traditional_Jewels"},"\n"]},"\n",{"tag":"td","children":["Varies\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["Lightsaber deals ",{"tag":"a","children":["Stun"],"href":"https://swse.miraheze.org/wiki/Stun"}," damage instead of normal damage.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Compressed Crystal"],"href":"https://swse.miraheze.org/wiki/Compressed_Crystal","referenceId":"reference:8932fbaccc7da762"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Synthetic Crystals"],"href":"https://swse.miraheze.org/wiki/Synthetic_Crystals"},"\n"]},"\n",{"tag":"td","children":["Red or Varies\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":["Increases difficulty of ",{"tag":"b","children":[{"tag":"a","children":["Block"],"href":"https://swse.miraheze.org/wiki/Block"}]}," attempts.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Corusca Gem"],"href":"https://swse.miraheze.org/wiki/Corusca_Gem","referenceId":"reference:55317f60989b271f"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Traditional Jewels"],"href":"https://swse.miraheze.org/wiki/Traditional_Jewels"},"\n"]},"\n",{"tag":"td","children":["Varies\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["+1 die of damage against a target with ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Dantari Crystal"],"href":"https://swse.miraheze.org/wiki/Dantari_Crystal","referenceId":"reference:230951e79629d033"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Rare Crystals"],"href":"https://swse.miraheze.org/wiki/Rare_Crystals"},"\n"]},"\n",{"tag":"td","children":["Varies\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["Reflects the light or darkness within the wielder.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Dragite Crystal"],"href":"https://swse.miraheze.org/wiki/Dragite_Crystal","referenceId":"reference:2f597a7846c1e96c"},"\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Traditional Jewels"],"href":"https://swse.miraheze.org/wiki/Traditional_Jewels"},"\n"]},"\n",{"tag":"td","children":["Varies\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":["+1 die of ",{"tag":"a","children":["Sonic"],"href":"https://swse.miraheze.org/wiki/Sonic"}," damage on ",{"tag":"a","children":["Critical Hits"],"href":"https://swse.miraheze.org/wiki/Critical_Hits"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Durindfire Crystal"],"href":"https://swse.miraheze.org/wiki/Durindfire_Crystal","referenceId":"reference:946647f9f1bc8628