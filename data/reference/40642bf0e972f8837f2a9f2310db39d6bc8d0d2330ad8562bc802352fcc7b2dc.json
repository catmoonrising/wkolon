,{"tag":"a","children":["Energy Cell"],"href":"https://swse.miraheze.org/wiki/Energy_Cell","referenceId":"reference:a3dedb9c17e4ee9d"}," to operate (the cost is ten times the price of an ordinary ",{"tag":"a","children":["Energy Cell"],"href":"https://swse.miraheze.org/wiki/Energy_Cell","referenceId":"reference:a3dedb9c17e4ee9d"},", but it lasts almost indefinitely).\n"]},{"tag":"p","children":[{"tag":"b","children":["Weapon Type:"]}," ",{"tag":"a","children":["Lightsabers"],"href":"https://swse.miraheze.org/wiki/Lightsabers","referenceId":"reference:420c60d0a682943a"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Size:"]}," Medium\n"]},{"tag":"p","children":[{"tag":"b","children":["Cost:"]}," 2,500\n"]},{"tag":"p","children":[{"tag":"b","children":["Damage:"]}," 2d6\n"]},{"tag":"p","children":[{"tag":"b","children":["Weight:"]}," 0.5 Kilograms\n"]},{"tag":"p","children":[{"tag":"b","children":["Type:"]}," Energy and Slashing\n"]},{"tag":"p","children":[{"tag":"b","children":["Availability:"]}," ",{"tag":"a","children":["Rare"],"href":"https://swse.miraheze.org/wiki/Rare"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Special:"]}," Can be ",{"tag":"a","children":["Thrown"],"href":"https://swse.miraheze.org/wiki/Thrown"},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
