ancements"}," (",{"tag":"a","children":["Saga Edition FAQ"],"href":"https://swse.miraheze.org/wiki/Saga_Edition_FAQ"}," (E27)"]},")\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Stun"],"href":"https://swse.miraheze.org/wiki/Stun"}," Setting:"]}," NO\n"]},{"tag":"p","children":[{"tag":"b","children":["Rate of Fire:"]}," Single-Shot\n"]},{"tag":"p","children":[{"tag":"b","children":["Weight:"]}," 8 Kilograms (",{"tag":"i","children":[{"tag":"a","children":["Scum and Villainy"],"href":"https://swse.miraheze.org/wiki/Scum_and_Villainy"}]},") or 5.5 Kilograms (",{"tag":"i","children":[{"tag":"a","children":["Web Enhancements"],"href":"https://swse.miraheze.org/wiki/Web_Enhancements"}," (",{"tag":"a","children":["Saga Edition FAQ"],"href":"https://swse.miraheze.org/wiki/Saga_Edition_FAQ"}," (E27)"]},")\n"]},{"tag":"p","children":[{"tag":"b","children":["Type:"]}," Energy\n"]},{"tag":"p","children":[{"tag":"b","children":["Availability:"]}," ",{"tag":"a","children":["Military"],"href":"https://swse.miraheze.org/wiki/Military"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Accurate:"]}," This weapon takes no penalty when firing at targets at Short ",{"tag":"a","children":["Range"],"href":"https://swse.miraheze.org/wiki/Range"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
