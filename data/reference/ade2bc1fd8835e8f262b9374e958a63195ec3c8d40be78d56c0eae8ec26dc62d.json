=1"}," causes a Barab Ingot to produce a ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," blade that burns like ",{"tag":"a","children":["Fire"],"href":"https://swse.miraheze.org/wiki/Fire","referenceId":"reference:c141faa80e43a119"},".\n"]},{"tag":"p","children":["A ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," constructed with a Barab Ingot deals ",{"tag":"a","children":["Fire"],"href":"https://swse.miraheze.org/wiki/Fire","referenceId":"reference:c141faa80e43a119"}," damage instead of Energy and Slashing damage. Any target that takes damage from the weapon also catches on ",{"tag":"a","children":["Fire"],"href":"https://swse.miraheze.org/wiki/Fire","referenceId":"reference:c141faa80e43a119"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
