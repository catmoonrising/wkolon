ag":"td","children":["+1\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Defense"],"href":"https://swse.miraheze.org/wiki/Defense"}," Bonuses, ",{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},"\n"]},"\n",{"tag":"td","children":["6th\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":["Familiar Foe +3\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["2nd\n"]},"\n",{"tag":"td","children":["+2\n"]},"\n",{"tag":"td","children":["Familiar Foe +1\n"]},"\n",{"tag":"td","children":["7th\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["3rd\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},"\n"]},"\n",{"tag":"td","children":["8th\n"]},"\n",{"tag":"td","children":["+8\n"]},"\n",{"tag":"td","children":["Familiar Foe +4\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["4th\n"]},"\n",{"tag":"td","children":["+4\n"]},"\n",{"tag":"td","children":["Familiar Foe +2\n"]},"\n",{"tag":"td","children":["9th\n"]},"\n",{"tag":"td","children":["+9\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["5th\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},"\n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Familiar Foe +5\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Bounty Hunters gain a +4 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", and a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Bounty Hunters gain 1d10 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Bounty Hunters gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, each time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Bounty Hunter gains an additional ",{"tag":"a","children":["Bounty Hunter Talent"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent"},". A Bounty Hunter may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Bounty Hunter Talent Trees"],"href":"https://swse.miraheze.org/wiki/Bounty_Hunter_Talent_Trees","referenceId":"reference:f16ca1fb88bbbd1e"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Familiar Foe"]},"\n",{"tag":"p","children":["By observing your opponent in combat, you know how to defeat them more easily. If you spend a ",{"tag":"a","children":["Full-Round Action"],"href":"https://swse.miraheze.org/wiki/Full-Round_Action"}," observing an opponent in combat, you gain a bonus on attack rolls against that opponent, and a bonus to your ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," against attacks made by that opponent equal to one-half your Class Level (rounded down). The effects last until the end of the encounter. You cannot use this ability until after your opponent has acted during combat.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
