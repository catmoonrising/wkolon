isdom"],"href":"https://swse.miraheze.org/wiki/Wisdom"},". ",{"tag":"a","children":["Strength"],"href":"https://swse.miraheze.org/wiki/Strength"}," is also useful for the Scout ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in athletic abilities."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, a Scout gains a +1 Class bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"}," and a +2 Class bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," Scouts begin play at 1st level with a number of ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," equal to 24 + ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier. At each level after 1st, Scouts gain 1d8 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Skills:"]}," 1st-level Scout are ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in a number of ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," equal to 5 + their ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," modifier. They have the following ",{"tag":"a","children":["Class Skills"],"href":"https://swse.miraheze.org/wiki/Class_Skills","referenceId":"reference:eab4e467351b3882"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Climb"],"href":"https://swse.miraheze.org/wiki/Climb","referenceId":"reference:98ca5f27d9642dc7"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Endurance"],"href":"https://swse.miraheze.org/wiki/Endurance","referenceId":"reference:98c8abf84e23ff3f"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Jump"],"href":"https://swse.miraheze.org/wiki/Jump","referenceId":"reference:9ee0ca3e24d60ea0"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Knowledge"],"href":"https://swse.miraheze.org/wiki/Knowledge","referenceId":"reference:dcb3e1c00e79236d"}," (all; taken individually),"]},"\n",{"tag":"li","children":[{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Ride"],"href":"https://swse.miraheze.org/wiki/Ride","referenceId":"reference:439efdc566bb419f"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Survival"],"href":"https://swse.miraheze.org/wiki/Survival","referenceId":"reference:8302496de0ace160"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Swim"],"href":"https://swse.miraheze.org/wiki/Swim","referenceId":"reference:dd4fa375c70c4e42"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Starting Feats:"]}," At 1st level, a Scout gains the following starting ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Shake It Off"],"href":"https://swse.miraheze.org/wiki/Shake_It_Off","referenceId":"reference:1fd7ddbdac3bffba"}," (must have the prerequisite ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," of 13 and be ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in ",{"tag":"a","children":["Endurance"],"href":"https://swse.miraheze.org/wiki/Endurance","referenceId":"reference:98c8abf84e23ff3f"},"),"]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Pistols)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Pistols)"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Rifles)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Rifles)"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Simple Weapons)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Simple_Weapons)"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Scouts gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 5 + one-half their Character Level (rounded down) at 1st level, and every time they gain a new level in this ",{"tag":"a","children":["Heroic Class"],"href":"https://swse.miraheze.org/wiki/Heroic_Class"},". Any ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," left over from the previous levels are lost."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Credits:"]}," A 1st-level Scout starts play with 3d4 x 250 credits."]}]},"\n",{"tag":"h3","children":["Talent Trees"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Scout gains an additional ",{"tag":"a","children":["Scout Talent"],"href":"https://swse.miraheze.org/wiki/Scout_Talent"},". A Scout may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Scout Talent Trees"],"href":"https://swse.miraheze.org/wiki/Scout_Talent_Trees","referenceId":"reference:b06a2f19f729852b"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Bonus Feats"]},"\n",{"tag":"p","children":["At each even-numbered level (2nd, 4th, 6th, etc.), a Scout gains a bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". This ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be selected from the ",{"tag":"a","children":["Scout Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Scout_Bonus_Feats","referenceId":"reference:f89dae384e2b6c29"}," list. As with normal ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},", you must meet the prerequisites to select the ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". The Bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be from the ",{"tag":"a","children":["Scout Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Scout_Bonus_Feats","referenceId":"reference:f89dae384e2b6c29"}," list, unless explicitly stated otherwise.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
