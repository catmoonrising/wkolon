 ",{"tag":"a","children":["Clone Trooper Battalion"],"href":"https://swse.miraheze.org/wiki/Clone_Trooper_Battalion","referenceId":"reference:fc462e7b74175fda"}," with 60 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," can be healed only up to 63 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},", the next highest ",{"tag":"a","children":["Attrition"],"href":"https://swse.miraheze.org/wiki/Attrition"}," number.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
