isite:"]}," ",{"tag":"b","children":["Opportunistic Strike"]},"\n"]},{"tag":"p","children":["Whenever an opponent uses the ",{"tag":"a","children":["Withdraw"],"href":"https://swse.miraheze.org/wiki/Withdraw","referenceId":"reference:164546a9c5481480"}," Action to leave your ",{"tag":"a","children":["Threatened Area"],"href":"https://swse.miraheze.org/wiki/Threatened_Area"},", that opponent is considered ",{"tag":"a","children":["Flat-Footed"],"href":"https://swse.miraheze.org/wiki/Flat-Footed"}," against you until the end of your next turn.\n"]},"\n",{"tag":"h3","children":["Opportunistic Strike"]},"\n",{"tag":"p","children":["Once per encounter, you can make an ",{"tag":"a","children":["Attack of Opportunity"],"href":"https://swse.miraheze.org/wiki/Attack_of_Opportunity"}," against an opponent within Point-Blank ",{"tag":"a","children":["Range"],"href":"https://swse.miraheze.org/wiki/Range"}," (even using a ranged weapon), if that opponent provokes an ",{"tag":"a","children":["Attack of Opportunity"],"href":"https://swse.miraheze.org/wiki/Attack_of_Opportunity"}," from one of your allies.\n"]},"\n",{"tag":"h3","children":["Slippery Strike"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisite:"]}," ",{"tag":"b","children":["Strike and Run"]},"\n"]},{"tag":"p","children":["Once per encounter, you can designate an opponent you have just damaged as a ",{"tag":"a","children":["Reaction"],"href":"https://swse.miraheze.org/wiki/Reaction"},"; that opponent cannot make ",{"tag":"a","children":["Attacks of Opportunity"],"href":"https://swse.miraheze.org/wiki/Attacks_of_Opportunity","referenceId":"reference:3f19aef95d530255"}," against you until the end of your next turn. You may use this in conjunction with the ",{"tag":"b","children":["Strike and Run"]}," Talent, allowing you to benefit from both Talents as a single ",{"tag":"a","children":["Reaction"],"href":"https://swse.miraheze.org/wiki/Reaction"},".\n"]},"\n",{"tag":"h3","children":["Strike and Run"]},"\