ge Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"}," by 5 until the end of your next turn. Additionally, if the target is mechanical or electronic, it automatically moves -1 step along the ",{"tag":"a","children":["Condition Track"],"href":"https://swse.miraheze.org/wiki/Condition_Track"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":["The target becomes cold to the touch and more fragile. Reduce the target's ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"}," by 10 until the end of your next turn. Additionally, if the target is mechanical or electronic, it automatically moves -1 step along the ",{"tag":"a","children":["Condition Track"],"href":"https://swse.miraheze.org/wiki/Condition_Track"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["30\n"]},"\n",{"tag":"td","children":["The target becomes cold to the touch and more fragile. Reduce the target's ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"}," by 15 until the end of your next turn. Additionally, if the target is mechanical or electronic, it automatically moves -1 step along the ",{"tag":"a","children":["Condition Track"],"href":"https://swse.miraheze.org/wiki/Condition_Track"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["35\n"]},"\n",{"tag":"td","children":["The target becomes cold to the touch and more fragile. Reduce the target's ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"}," by 20 until the end of your next turn. Additionally, if the target is mechanical or electronic, it automatically moves -1 step along the ",{"tag":"a","children":["Condition Track"],"href":"https://swse.miraheze.org/wiki/Condition_Track"},".\n"]}]}]}]},"\n",{"tag":"p","children":[{"tag":"b","children":["Special: "]},"You can spend a ",{"tag":"a","chi