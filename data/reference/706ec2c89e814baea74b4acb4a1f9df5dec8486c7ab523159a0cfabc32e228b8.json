aheze.org/wiki/Knights_of_the_Old_Republic_Campaign_Guide"}]},"); 35% ",{"tag":"a","children":["Human"],"href":"https://swse.miraheze.org/wiki/Human","referenceId":"reference:9ffa865f2bc6e850"},", 18% ",{"tag":"a","children":["Dantari"],"href":"https://swse.miraheze.org/wiki/Dantari?action=edit&redlink=1"}," (Native), 47% Other ",{"tag":"a","children":["Species"],"href":"https://swse.miraheze.org/wiki/Species","referenceId":"reference:56205e12c20fb568"}," (",{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},")\n"]},{"tag":"p","children":[{"tag":"b","children":["Government:"]}," Oligarchy (",{"tag":"i","children":[{"tag":"a","children":["Knights of the Old Republic Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Knights_of_the_Old_Republic_Campaign_Guide"}]},"); Tribal (",{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},")\n"]},{"tag":"p","children":[{"tag":"b","children":["Capital:"]}," Garang (",{"tag":"i","children":[{"tag":"a","children":["Knights of the Old Republic Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Knights_of_the_Old_Republic_Campaign_Guide"}]},"); Garang and Khoonda (",{"tag":"i","children":[{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},")\n"]},{"tag":"p","children":[{"tag":"b","children":["Major Exports:"]}," Foodstuffs\n"]},{"tag":"p","children":[{"tag":"b","children":["Major Imports:"]}," Luxury Items, Technology\n"]},"\n",{"tag":"h4","children":["Galactic Lore"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Knights of the Old Republic Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Knights_of_the_Old_Republic_Campaign_Guide"}]},"\n"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["DC\n"]},"\n",{"tag":"th","children":["RESULT\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["Dantooine is a pleasant world covered in rolling hills, wide-open plains, and bountiful farmland available for cultivation.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["Dantooine has only a few scattered settlements, which are inhabited by wealthy farmers whose lands produce the majority of the planet's food exports.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["A Jedi Enclave exists on Dantooine, serving as a training facility for Jedi away from ",{"tag":"a","children":["Coruscant"],"href":"https://swse.miraheze.org/wiki/Coruscant","referenceId":"reference:2ee37a21e9e7a955"},". After ",{"tag":"a","children":["The Jedi Civil War"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Civil_War"},", the enclave is destroyed, and only ruins remain.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":["Dantooine is also the home to a primitive ",{"tag":"a","children":["Species"],"href":"https://swse.miraheze.org/wiki/Species","referenceId":"reference:56205e12c20fb568"}," known as the ",{"tag":"a","children":["Dantari"],"href":"https://swse.miraheze.org/wiki/Dantari?action=edit&redlink=1"},", who stay far away from most other settlements.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["30\n"]},"\n",{"tag":"td","children":["Several temples and other structures scattered throughout the planet were built by the ancient ",{"tag":"a","children":["Species"],"href":"https://swse.miraheze.org/wiki/Species","referenceId":"reference:56205e12c20fb568"}," known as the ",{"tag":"a","children":["Rakata"],"href":"https://swse.miraheze.org/wiki/Rakata","referenceId":"reference:0b233b768a3d506b"},", whose Infinite Empire stretched from one side of the galaxy to the other.\n"]}]}]}]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["DC\n"]},"\n",{"tag":"th","children":["RESULT\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["Dantooine is an Outer Rim world positioned near the Hydian Way hyperspace route. The temperate climate supports a multitude of flora and fauna and makes it an ideal planet for agriculture.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["The Jedi Enclave on Dantooine trains many Jedi during the times of ",{"tag":"a","children":["The Great Sith War"],"href":"https://swse.miraheze.org/wiki/The_Great_Sith_War"}," and ",{"tag":"a","children":["The Jedi Civil War"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Civil_War"},". Although ",{"tag":"a","children":["The Jedi"],"href":"https://swse.miraheze.org/wiki/The_Jedi","referenceId":"reference:d320edb17de6c558"}," work hard to keep its location secret, ",{"tag":"a","children":["The Sith Empire"],"href":"https://swse.miraheze.org/wiki/The_Sith_Empire","referenceId":"reference:303e4cc32aa1a8e1"}," attack the facility several times while it is active.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["Dantooine is the site of a significant battle between the Republic and the Confederacy during ",{"tag":"a","children":["The Clone Wars"],"href":"https://swse.miraheze.org/wiki/The_Clone_Wars"},". During this battle, Jedi Master ",{"tag":"a","children":["Mace Windu"],"href":"https://swse.miraheze.org/wiki/Mace_Windu","referenceId":"reference:95ecd6d4c9449681"}," almost single-handedly defeats a Droid Army consisting of ",{"tag":"a","children":["B2-Series Super Battle Droids"],"href":"https://swse.miraheze.org/wiki/B2-Series_Super_Battle_Droids"},", even though he is without his ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," for most of the fight.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["Ruins of an ancient Jedi Temple exist that predate the Jedi Enclave created by Jedi Master ",{"tag":"a","children":["Vodo-Siosk Baas"],"href":"https://swse.miraheze.org/wiki/Vodo-Siosk_Baas","referenceId":"reference:e0dadafd15948ce2"},".\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["25\n"]},"\n",{"tag":"td","children":["The planet was one of the subject worlds of ",{"tag":"a","children":["The Infinite Empire"],"href":"https://swse.miraheze.org/wiki/The_Infinite_Empire","referenceId":"reference:ee33f172f47041dd"},". Ancient ",{"tag":"a","children":["Rakata"],"href":"https://swse.miraheze.org/wiki/Rakata","referenceId":"reference:0b233b768a3d506b"}," built several structures on the planet's surface, one of which is believed to house a Star Map. By the time of ",{"tag":"a","children":["The Jedi Civil War"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Civil_War"},", several ",{"tag":"a","children":["Rakatan Guardian Droids"],"href":"https://swse.miraheze.org/wiki/Rakatan_Guardian_Droids?action=edit&redlink=1"}," still operate within the ruins of these ancient structures.\n"]}]}]}]},"\n",{"tag":"h4","children":["Social Sciences"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["DC\n"]},"\n",{"tag":"th","children":["RESULT\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["The ",{"tag":"a","children":["Human"],"href":"https://swse.miraheze.org/wiki/Human","referenceId":"reference:9ffa865f2bc6e850"}," farmers who inhabit the planet live in single-family settlements and small communities that are mostly isolated from each other.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["The population of Dantooine has no planetary militia of its own and depends on ",{"tag":"a","children":["The Jedi Order"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Order"}," for protection during the days of the Republic. When the Empire replaces the Republic, Imperial forces station a garrison at the ruins of the Jedi Enclave.\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["Although ",{"tag":"a","children":["Humans"],"href":"https://swse.miraheze.org/wiki/Humans"}," make up the largest percentage of the world population, the ",{"tag":"a","children":["Dantari"],"href":"https://swse.miraheze.org/wiki/Dantari?action=edit&redlink=1"}," race has claimed Dantooine as their homeworld for many centuries. Records dating back to the early days of the Republic confirm their existence on the planet. The ",{"tag":"a","children":["Dantari"],"href":"https://swse.miraheze.org/wiki/Dantari?action=edit&redlink=1"}," are wiped out during the Yuuzhan Vong Invasion.\n"]}]}]}]},"\n","\n",{"tag":"h2","children":["Temples and Academies"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Jedi Academy Training Manual"],"href":"https://swse.miraheze.org/wiki/Jedi_Academy_Training_Manual"}]},"\n"]},{"tag":"p","children":["The Jedi Enclave on Dantooine carries a troubled past. Established by Jedi Master ",{"tag":"a","children":["Vodo-Siosk Baas"],"href":"https://swse.miraheze.org/wiki/Vodo-Siosk_Baas","referenceId":"reference:e0dadafd15948ce2"}," shortly before ",{"tag":"a","children":["The Great Sith War"],"href":"https://swse.miraheze.org/wiki/The_Great_Sith_War"},", the enclave quickly gains a reputation as a quality training center. Many Jedi, including some of the great Jedi Masters of the time, base themselves from Dantooine to further their training and continue their research into the ways of ",{"tag":"a","children":["The Force"],"href":"https://swse.miraheze.org/wiki/The_Force","referenceId":"reference:67fe90e919b74d0f"},". Many great Jedi who serve during ",{"tag":"a","children":["The Great Sith War"],"href":"https://swse.miraheze.org/wiki/The_Great_Sith_War"}," complete their training on Dantooine as well. At the same time, many of the era's worst darksiders come from the enclave, including ",{"tag":"a","children":["Exar Kun"],"href":"https://swse.miraheze.org/wiki/Exar_Kun","referenceId":"reference:ecc01bec6de14936"},", ",{"tag":"a","children":["Darth Revan"],"href":"https://swse.miraheze.org/wiki/Darth_Revan"},", and ",{"tag":"a","children":["Darth Malak"],"href":"https://swse.miraheze.org/wiki/Darth_Malak","referenceId":"reference:9428775bff11dbd6"},".\n"]},{"tag":"p","children":["Despite its strong contingent of Jedi, the enclave is attacked numerous times by Sith forces. ",{"tag":"a","children":["The Sith Empire"],"href":"https://swse.miraheze.org/wiki/The_Sith_Empire","referenceId":"reference:303e4cc32aa1a8e1"}," even manage to occupy the compound for a year before the Empire's collapse in 3,956 BBY. ",{"tag":"a","children":["The Jedi Order"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Order"}," strive to rebuild and maintain the facility for the next few decades and even decide to house the reformed Jedi Council there. However, it is finally abandoned after ",{"tag":"a","children":["Darth Traya"],"href":"https://swse.miraheze.org/wiki/Darth_Traya","referenceId":"reference:089c0cd1c5512658"}," kills the entire Jedi Council a few years later.\n"]},{"tag":"p","children":["Dantooine's Jedi Enclave employs many individuals from the local population to help maintain the facility, provide services, and keep the campus in top working order. ",{"tag":"a","children":["Arakyd Industries"],"href":"https://swse.miraheze.org/wiki/Arakyd_Industries","referenceId":"reference:53475569f2ae9d67"}," operates a company store and repair facility at the enclave, servicing ",{"tag":"a","children":["The Jedi"],"href":"https://swse.miraheze.org/wiki/The_Jedi","referenceId":"reference:d320edb17de6c558"}," as well as the local population.\n"]},"\n",{"tag":"h3","children":["Jedi Temple Adventure Hook"]},"\n",{"tag":"p","children":["Adventure and excitement accompany ",{"tag":"a","children":["The Jedi Order"],"href":"https://swse.miraheze.org/wiki/The_Jedi_Order"}," wherever it goes. Since The Jedi Order maintains only one key temple at a time, adventure ideas should be easy to focus and implement, depending on the era of your campaign.\n"]},"\n",{"tag":"ul","children":[{"tag":"li","children":["The heroes hear rumors of strange activity at the ancient ruin of the Jedi Enclave on Dantooine. Perhaps pirates are using the location as a base for raids in the sector, or Sith agents are looking for artifacts hidden in the ruins."]}]},"\n","\n","\n","\n\n","\n\n","\n"]}}
