":"td","children":["8\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feat"},"\n"]},"\n",{"tag":"td","children":["18\n"]},"\n",{"tag":"td","children":["+13\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["9\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Talent"],"href":"https://swse.miraheze.org/wiki/Noble_Talent"},"\n"]},"\n",{"tag":"td","children":["19\n"]},"\n",{"tag":"td","children":["+14\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Talent"],"href":"https://swse.miraheze.org/wiki/Noble_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feat"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["+15\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Noble Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feat"},"\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Abilities:"]}," ",{"tag":"a","children":["Charisma"],"href":"https://swse.miraheze.org/wiki/Charisma"}," is undoubtedly the Noble's most important ",{"tag":"a","children":["Ability Score"],"href":"https://swse.miraheze.org/wiki/Ability_Score"},", as the Noble's skill at interacting with others and projecting a sense of confidence are crucial for their success. ",{"tag":"a","children":["Wisdom"],"href":"https://swse.miraheze.org/wiki/Wisdom"}," and ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," are also significant for their related ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, a Noble gains a +1 Class bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," and a +2 Class bonus to their ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," Nobles begin play at 1st level with a number of ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," equal to 18 + ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier. At each level after 1st, Nobles gain 1d6 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Skills:"]}," 1st-level Noble are ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in a number of ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," equal to 6 + their ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," modifier. They have the following ",{"tag":"a","children":["Class Skills"],"href":"https://swse.miraheze.org/wiki/Class_Skills","referenceId":"reference:eab4e467351b3882"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Deception"],"href":"https://swse.miraheze.org/wiki/Deception","referenceId":"reference:17455029fb9994a3"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Gather Information"],"href":"https://swse.miraheze.org/wiki/Gather_Information","referenceId":"reference:a719fb58321fb08c"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Knowledge"],"href":"https://swse.miraheze.org/wiki/Knowledge","referenceId":"reference:dcb3e1c00e79236d"}," (all; taken individually),"]},"\n",{"tag":"li","children":[{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Persuasion"],"href":"https://swse.miraheze.org/wiki/Persuasion","referenceId":"reference:196fbdc5f1823320"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Ride"],"href":"https://swse.miraheze.org/wiki/Ride","referenceId":"reference:439efdc566bb419f"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Treat Injury"],"href":"https://swse.miraheze.org/wiki/Treat_Injury","referenceId":"reference:f1b9875c2302ce61"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Use Computer"],"href":"https://swse.miraheze.org/wiki/Use_Computer","referenceId":"reference:ff8449006aafd27d"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Starting Feats:"]}," At 1st level, a Noble gains the following starting ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Linguist"],"href":"https://swse.miraheze.org/wiki/Linguist","referenceId":"reference:8ece6158f988da80"}," (must have the prerequisite ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," of 13),"]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Pistols)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Pistols)"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Simple Weapons)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Simple_Weapons)"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Nobles gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 5 + one-half their Character Level (rounded down) at 1st level, and every time they gain a new level in this ",{"tag":"a","children":["Heroic Class"],"href":"https://swse.miraheze.org/wiki/Heroic_Class"},". Any ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," left over from the previous levels are lost."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Credits:"]}," A 1st-level Noble starts play with 3d4 x 400 credits."]}]},"\n",{"tag":"h3","children":["Talent Trees"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Noble gains an additional ",{"tag":"a","children":["Noble Talent"],"href":"https://swse.miraheze.org/wiki/Noble_Talent"},". A Noble may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Noble Talent Trees"],"href":"https://swse.miraheze.org/wiki/Noble_Talent_Trees","referenceId":"reference:173231c5f0650214"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Bonus Feats"]},"\n",{"tag":"p","children":["At each even-numbered level (2nd, 4th, 6th, etc.), a Noble gains a bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". This ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be selected from the ",{"tag":"a","children":["Noble Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feats","referenceId":"reference:55f0bfc268dc3595"}," list. As with normal ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},", you must meet the prerequisites to select the ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". The Bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be from the ",{"tag":"a","children":["Noble Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Noble_Bonus_Feats","referenceId":"reference:55f0bfc268dc3595"}," list, unless explicitly stated otherwise.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
