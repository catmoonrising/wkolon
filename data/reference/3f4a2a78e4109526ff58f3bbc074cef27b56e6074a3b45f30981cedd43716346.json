/wiki/Scoundrel_Bonus_Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["5\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]},"\n",{"tag":"td","children":["15\n"]},"\n",{"tag":"td","children":["+11\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["6\n"]},"\n",{"tag":"td","children":["+4\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]},"\n",{"tag":"td","children":["16\n"]},"\n",{"tag":"td","children":["+12\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["7\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]},"\n",{"tag":"td","children":["17\n"]},"\n",{"tag":"td","children":["+12\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["8\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]},"\n",{"tag":"td","children":["18\n"]},"\n",{"tag":"td","children":["+13\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["9\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]},"\n",{"tag":"td","children":["19\n"]},"\n",{"tag":"td","children":["+14\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]},"\n",{"tag":"td","children":["20\n"]},"\n",{"tag":"td","children":["+15\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Scoundrel Bonus Feat"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feat"},"\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Abilities:"]}," ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"}," and ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," are the Scoundrel's most important ",{"tag":"a","children":["Ability Scores"],"href":"https://swse.miraheze.org/wiki/Ability_Scores"},", because they must have quick reflexes and a sharp wit to survive. ",{"tag":"a","children":["Charisma"],"href":"https://swse.miraheze.org/wiki/Charisma"}," is important for talking one's way out of trouble, and ",{"tag":"a","children":["Wisdom"],"href":"https://swse.miraheze.org/wiki/Wisdom"}," is useful for spotting trouble before it finds the Scoundrel."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, a Scoundrel gains a +2 Class bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," and a +1 Class bonus to their ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," Scoundrels begin play at 1st level with a number of ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," equal to 18 + ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier. At each level after 1st, Scoundrels gain 1d6 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Skills:"]}," 1st-level Scoundrel are ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in a number of ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," equal to 4 + their ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," modifier. They have the following ",{"tag":"a","children":["Class Skills"],"href":"https://swse.miraheze.org/wiki/Class_Skills","referenceId":"reference:eab4e467351b3882"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Acrobatics"],"href":"https://swse.miraheze.org/wiki/Acrobatics","referenceId":"reference:0d0b7eee2953750e"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Deception"],"href":"https://swse.miraheze.org/wiki/Deception","referenceId":"reference:17455029fb9994a3"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Gather Information"],"href":"https://swse.miraheze.org/wiki/Gather_Information","referenceId":"reference:a719fb58321fb08c"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Knowledge"],"href":"https://swse.miraheze.org/wiki/Knowledge","referenceId":"reference:dcb3e1c00e79236d"}," (all; taken individually),"]},"\n",{"tag":"li","children":[{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Persuasion"],"href":"https://swse.miraheze.org/wiki/Persuasion","referenceId":"reference:196fbdc5f1823320"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Use Computer"],"href":"https://swse.miraheze.org/wiki/Use_Computer","referenceId":"reference:ff8449006aafd27d"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Starting Feats:"]}," At 1st level, a Scoundrel gains the following starting ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},":\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"a","children":["Point-Blank Shot"],"href":"https://swse.miraheze.org/wiki/Point-Blank_Shot","referenceId":"reference:7464dcbe8125c639"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Pistols)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Pistols)"},","]},"\n",{"tag":"li","children":[{"tag":"a","children":["Weapon Proficiency (Simple Weapons)"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency_(Simple_Weapons)"}]}]}]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Scoundrels gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 5 + one-half their Character Level (rounded down) at 1st level, and every time they gain a new level in this ",{"tag":"a","children":["Heroic Class"],"href":"https://swse.miraheze.org/wiki/Heroic_Class"},". Any ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," left over from the previous levels are lost."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Credits:"]}," A 1st-level Scoundrel starts play with 3d4 x 250 credits."]}]},"\n",{"tag":"h3","children":["Talent Trees"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Scoundrel gains an additional ",{"tag":"a","children":["Scoundrel Talent"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent"},". A Scoundrel may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Scoundrel Talent Trees"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Talent_Trees","referenceId":"reference:17c17c9919eeea8f"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Bonus Feats"]},"\n",{"tag":"p","children":["At each even-numbered level (2nd, 4th, 6th, etc.), a Scoundrel gains a bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". This ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be selected from the ",{"tag":"a","children":["Scoundrel Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feats","referenceId":"reference:112eb1a40ba79d77"}," list. As with normal ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"},", you must meet the prerequisites to select the ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". The Bonus ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," must be from the ",{"tag":"a","children":["Scoundrel Bonus Feats"],"href":"https://swse.miraheze.org/wiki/Scoundrel_Bonus_Feats","referenceId":"reference:112eb1a40ba79d77"}," list, unless explicitly stated otherwise.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
