raheze.org/wiki/Force_Powers","referenceId":"reference:85acec94cd1ca5f3"},", ",{"tag":"a","children":["Force Techniques"],"href":"https://swse.miraheze.org/wiki/Force_Techniques"},", or ",{"tag":"a","children":["Force Secrets"],"href":"https://swse.miraheze.org/wiki/Force_Secrets"}," within a Ysalamiri's bubble, nor can they make a ",{"tag":"a","children":["Use the Force"],"href":"https://swse.miraheze.org/wiki/Use_the_Force","referenceId":"reference:74883d1dd46b87fe"}," check of any kind. ",{"tag":"a","children":["Force Powers"],"href":"https://swse.miraheze.org/wiki/Force_Powers","referenceId":"reference:85acec94cd1ca5f3"}," activated outside the bubble cannot penetrate it, and they cease to function if the users of the ability moves into the Ysalamiri's radius. This ability is automatic; the Ysalamiri cannot control it or turn it off. Force-users who are affected by the Ysalamiri's Nullify Force ability are immediately aware of it, and though they might not understand the source of the interference, they immediately recognize that attempts at using ",{"tag":"a","children":["The Force"],"href":"https://swse.miraheze.org/wiki/The_Force","referenceId":"reference:67fe90e919b74d0f"}," are entirely futile.\n"]},"\n",{"tag":"h4","children":["-1 Condition"]},"\n",{"tag":"p","children":["Tiny ",{"tag":"a","children":["Beast"],"href":"https://swse.miraheze.org/wiki/Beast","referenceId":"reference:628bf77a740094a9"}," 1\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," -3; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Low-Light Vision"],"href":"https://swse.miraheze.org/wiki/Low-Light_Vision"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," -3\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a"