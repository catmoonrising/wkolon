raheze.org/wiki/Hands"},", meaning that the buyer need not purchase additional weaponry for a cadre of Patrol Droids. Many crime lords employ Z65 Patrol Droids for personal security.\n"]},{"tag":"p","children":["Z65 Patrol Droids can't be played as ",{"tag":"a","children":["Droid Heroes"],"href":"https://swse.miraheze.org/wiki/Droid_Heroes"},".\n"]},"\n",{"tag":"h2","children":["Z65 Patrol Droid Statistics (CL 3)"]},"\n",{"tag":"h4","children":["Normal"]},"\n",{"tag":"p","children":["Medium ",{"tag":"a","children":["4th-Degree Droid"],"href":"https://swse.miraheze.org/wiki/4th-Degree_Droid"}," ",{"tag":"a","children":["Nonheroic"],"href":"https://swse.miraheze.org/wiki/Nonheroic","referenceId":"reference:1bca2ef1d9ebe1c3"}," 6/",{"tag":"a","children":["Soldier"],"href":"https://swse.miraheze.org/wiki/Soldier","referenceId":"reference:f826baa05bef6921"}," 1\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +6; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Low-Light Vision"],"href":"https://swse.miraheze.org/wiki/Low-Light_Vision"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +12\n"]},{"tag":"p","children":[{"tag":"b","children":["Languages:"]}," Basic, ",{"tag":"a","children":["Binary"],"href":"https://swse.miraheze.org/wiki/Binary","referenceId":"reference:ee1c8277caf5fb9b"},"\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 21 (",{"tag":"a","children":["Flat-Footed"],"href":"https://swse.miraheze.org/wiki/Flat-Footed"},": 18), ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},": 15, ",{"tag":"a","children":["Will Defense"],"href":"https:/