ing a +2 ",{"tag":"a","children":["Equipment"],"href":"https://swse.miraheze.org/wiki/Equipment","referenceId":"reference:7f2465ac7cefab27"}," bonus to ",{"tag":"a","children":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"}," checks.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
