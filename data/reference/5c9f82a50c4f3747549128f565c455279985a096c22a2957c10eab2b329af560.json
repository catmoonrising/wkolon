se.miraheze.org/wiki/Equipment","referenceId":"reference:7f2465ac7cefab27"}," in the Ready Harness is halved for purposes of determining your ",{"tag":"a","children":["Encumbrance"],"href":"https://swse.miraheze.org/wiki/Encumbrance","referenceId":"reference:7c0376ae0ea9eee1"},", and such ",{"tag":"a","children":["Equipment"],"href":"https://swse.miraheze.org/wiki/Equipment","referenceId":"reference:7f2465ac7cefab27"}," can be retrieved or replaced as a ",{"tag":"a","children":["Move Action"],"href":"https://swse.miraheze.org/wiki/Move_Action"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
