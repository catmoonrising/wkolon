href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},", and a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to both their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," and ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Force Adepts gain 1d8 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Force Adepts gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, each time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Force Adept gains an additional ",{"tag":"a","children":["Force Adept Talent"],"href":"https://swse.miraheze.org/wiki/Force_Adept_Talent"},". A Force Adept may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Force Adept Talent Trees"],"href":"https://swse.miraheze.org/wiki/Force_Adept_Talent_Trees","referenceId":"reference:4e4086ab8d0cc52e"}," or ",{"tag":"a","children":["Force Talent Trees"],"href":"https://swse.miraheze.org/wiki/Force_Talent_Trees"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Force Techniques"]},"\n",{"tag":"p","children":["You have learned improved techniques to feel the rhythm of ",{"tag":"a","children":["The Force"],"href":"https://swse.miraheze.org/wiki/The_Force","referenceId":"reference:67fe90e919b74d0f"},". At every even-numbered level (2nd, 4th, 6th, and so on), a Force Adept gains one ",{"tag":"a","children":["Force Technique"],"href":"https://swse.miraheze.org/wiki/Force_Technique"}," that, once selected, cannot be changed.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
