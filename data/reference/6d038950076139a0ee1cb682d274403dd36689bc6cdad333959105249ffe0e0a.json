,"href":"https://swse.miraheze.org/wiki/Power_Pack","referenceId":"reference:2b783ab0537ca5d0"}," slot cannot be fired without first reinserting the ",{"tag":"a","children":["Power Pack"],"href":"https://swse.miraheze.org/wiki/Power_Pack","referenceId":"reference:2b783ab0537ca5d0"},".\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
