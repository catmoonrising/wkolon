.org/wiki/Armor_Proficiency_(Heavy)","referenceId":"reference:7773896a63cadb7f"},") feat and one ",{"tag":"a","children":["Weapon Proficiency"],"href":"https://swse.miraheze.org/wiki/Weapon_Proficiency"}," feat for which it meets the prerequisites."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Automatic Languages:"]}," All Battle Droids can speak, read, and write both Basic and ",{"tag":"a","children":["Binary"],"href":"https://swse.miraheze.org/wiki/Binary","referenceId":"reference:ee1c8277caf5fb9b"},"."]}]},"\n","\n","\n","\n\n","\n\n","\n"]}}
