evastating Attack"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"b","children":["Greater Weapon Focus"]}," (Chosen Weapon), ",{"tag":"b","children":[{"tag":"a","children":["Devastating Attack"],"href":"https://swse.miraheze.org/wiki/Devastating_Attack"}]}," (Chosen Weapon)\n"]},{"tag":"p","children":["Choose a single ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or ",{"tag":"a","children":["Weapon Group"],"href":"https://swse.miraheze.org/wiki/Weapon_Group"}," with which you're proficient. Whenever you make a successful attack against a target using the chosen ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or weapon from the chosen group, you treat your target's ",{"tag":"a","children":["Damage Threshold"],"href":"https://swse.miraheze.org/wiki/Damage_Threshold"}," as if it were 10 points lower when determining the results of your attack. This replaces the effects of the ",{"tag":"b","children":[{"tag":"a","children":["Devastating Attack"],"href":"https://swse.miraheze.org/wiki/Devastating_Attack"}]}," Talent.\n"]},"\n",{"tag":"h3","children":["Greater Penetrating Attack"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"b","children":["Greater Weapon Focus"]}," (Chosen Weapon), ",{"tag":"b","children":[{"tag":"a","children":["Penetrating Attack"],"href":"https://swse.miraheze.org/wiki/Penetrating_Attack"}]}," (Chosen Weapon)\n"]},{"tag":"p","children":["Choose a single ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or ",{"tag":"a","children":["Weapon Group"],"href":"https://swse.miraheze.org/wiki/Weapon_Group"}," with which you're proficient. Whenever you make a successful attack against a target using the chosen ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or weapon from the chosen group, you treat your target's ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"}," as if it were 10 points lower when determining the results of your attack. This replaces the effects of the ",{"tag":"b","children":[{"tag":"a","children":["Penetrating Attack"],"href":"https://swse.miraheze.org/wiki/Penetrating_Attack"}]}," Talent.\n"]},"\n",{"tag":"h3","children":["Greater Weapon Focus"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisite: "]},{"tag":"a","children":["Weapon Focus"],"href":"https://swse.miraheze.org/wiki/Weapon_Focus","referenceId":"reference:393613c18e211d0f"}," (Chosen Weapon)\n"]},{"tag":"p","children":["Choose one ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or ",{"tag":"a","children":["Weapon Group"],"href":"https://swse.miraheze.org/wiki/Weapon_Group"}," with which you're proficient. You gain a +1 bonus on attack rolls with the chosen ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or weapon from the chosen group. This bonus stacks with the bonus granted by the ",{"tag":"a","children":["Weapon Focus"],"href":"https://swse.miraheze.org/wiki/Weapon_Focus","referenceId":"reference:393613c18e211d0f"}," feat.  You may select this Talent multiple times. Each time you select this Talent, it applies to a different ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or ",{"tag":"a","children":["Weapon Group"],"href":"https://swse.miraheze.org/wiki/Weapon_Group"},".\n"]},"\n",{"tag":"h3","children":["Greater Weapon Specialization"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"b","children":["Greater Weapon Focus"]}," (Chosen Weapon), ",{"tag":"b","children":[{"tag":"a","children":["Weapon Specialization"],"href":"https://swse.miraheze.org/wiki/Weapon_Specialization"}]}," (Chosen Weapon)\n"]},{"tag":"p","children":["Choose one ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or one of the following weapon groups: ",{"tag":"a","children":["Advanced Melee Weapons"],"href":"https://swse.miraheze.org/wiki/Advanced_Melee_Weapons","referenceId":"reference:ffc93dd82af566f8"},", ",{"tag":"a","children":["Heavy Weapons"],"href":"https://swse.miraheze.org/wiki/Heavy_Weapons","referenceId":"reference:a2b1d4c4bac82300"},", ",{"tag":"a","children":["Pistols"],"href":"https://swse.miraheze.org/wiki/Pistols","referenceId":"reference:e660061b7b03b794"},", ",{"tag":"a","children":["Rifles"],"href":"https://swse.miraheze.org/wiki/Rifles","referenceId":"reference:a6ebe3ecc8b0b281"},", or ",{"tag":"a","children":["Simple Weapons"],"href":"https://swse.miraheze.org/wiki/Simple_Weapons"},". You gain a +2 bonus on damage rolls with the chosen ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or a weapon from the chosen group. This bonus stacks with the bonus granted by the ",{"tag":"b","children":[{"tag":"a","children":["Weapon Specialization"],"href":"https://swse.miraheze.org/wiki/Weapon_Specialization"}]}," Talent. You may select this Talent multiple times. Each time you select this Talent, it applies to a different ",{"tag":"a","children":["Exotic Weapon"],"href":"https://swse.miraheze.org/wiki/Exotic_Weapon"}," or ",{"tag":"a","children":["Weapon Group"],"href":"https://swse.miraheze.org/wiki/Weapon_Group"},".\n"]},"\n",{"tag":"h3","children":["Multiattack Proficiency (Heavy Weapons)"]},"\n",{"tag":"p","children":["Whenever you make multiple attacks with any type of ",{"tag":"a","children":["Heavy Weapon"],"href":"https://swse.miraheze.org/wiki/Heavy_Weapon"}," as a ",{"tag":"a","children":["Full-Round Action"],"href":"https://swse.miraheze.org/wiki/Full-Round_Action"}," (see ",{"tag":"a","children":["Full Attack"],"href":"https://swse.miraheze.org/wiki/Full_Attack"},"), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2.\n"]},"\n",{"tag":"h3","children":["Multiattack Proficiency (Rifles)"]},"\n",{"tag":"p","children":["Whenever you make multiple attacks with any type of ",{"tag":"a","children":["Rifle"],"href":"https://swse.miraheze.org/wiki/Rifle"}," as a ",{"tag":"a","children":["Full-Round Action"],"href":"https://swse.miraheze.org/wiki/Full-Round_Action"}," (see ",{"tag":"a","children":["Full Attack"],"href":"https://swse.miraheze.org/wiki/Full_Attack"},"), you reduce the penalty on your attack rolls by 2. You can take this Talent multiple times; each time you take this Talent, you reduce the penalty on your attack rolls by an additional 2.\n"]},"\n",{"tag":"h2","children":["Additional Talents"]},"\n",{"tag":"h3","children":["Extended Threat"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Unknown Regions Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Unknown_Regions_Campaign_Guide"}]},"\n"]},{"tag":"p","children":[{"tag":"i","children":["Prerequisite:"]}," ",{"tag":"a","children":["Weapon Focus"],"href":"https://swse.miraheze.org/wiki/Weapon_Focus","referenceId":"reference:393613c18e211d0f"}," (Chosen Weapon)\n"]},{"tag":"p","children":["When using a ranged weapon eligible to make ",{"tag":"a","children":["Attacks of Opportunity"],"href":"https://swse.miraheze.org/wiki/Attacks_of_Opportunity","referenceId":"reference:3f19aef95d530255"},", you ",{"tag":"a","children":["Threaten"],"href":"https://swse.miraheze.org/wiki/Threaten"}," all squares within a 2-square radius.\n"]},"\n",{"tag":"h3","children":["Ferocious Assault"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Galaxy at War"],"href":"https://swse.miraheze.org/wiki/Galaxy_at_War"}]},"\n"]},{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]