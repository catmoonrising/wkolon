n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Surprise Attack (+5)\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Vanguards gain a +4 class bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"}," and a +2 class bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Vanguards gain 1d10 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Vanguards gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, every time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Vanguard gains an additional ",{"tag":"a","children":["Vanguard Talent"],"href":"https://swse.miraheze.org/wiki/Vanguard_Talent"},". A Vanguard may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Vanguard Talent Trees"],"href":"https://swse.miraheze.org/wiki/Vanguard_Talent_Trees","referenceId":"reference:09bb6fd83b2b91b5"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Surprise Attack"]},"\n",{"tag":"p","children":["Whenever a Vanguard attacks a target that is unaware of them or otherwise denied their ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"}," bonus to ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", they gain a bonus on their first attack roll in a round against that target equal to one-half their Class Level.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
