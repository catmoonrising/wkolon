.org/wiki/Move_Action"}," (or you swim at your full ",{"tag":"a","children":["Speed"],"href":"https://swse.miraheze.org/wiki/Speed","referenceId":"reference:c372fee9b4566b85"}," as a ",{"tag":"a","children":["Full-Round Action"],"href":"https://swse.miraheze.org/wiki/Full-Round_Action"},").\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
