ren":["Explosive"],"href":"https://swse.miraheze.org/wiki/Explosive"}," deal no damage and instead turn the ",{"tag":"a","children":["Difficult Terrain"],"href":"https://swse.miraheze.org/wiki/Difficult_Terrain"}," into normal terrain.\n"]},"\n",{"tag":"h3","children":["Problem Solver"]},"\n",{"tag":"p","children":["As a ",{"tag":"a","children":["Swift Action"],"href":"https://swse.miraheze.org/wiki/Swift_Action"}," once per turn, you can designate a single ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"}," within your ",{"tag":"a","children":["Line of Sight"],"href":"https://swse.miraheze.org/wiki/Line_of_Sight","referenceId":"reference:7ae5eaf79143552f"}," whose ",{"tag":"a","children":["Vehicle Pilot"],"href":"https://swse.miraheze.org/wiki/Vehicle_Pilot","referenceId":"reference:4aff6d0e54fff36e"}," can hear and understand you. That pilot's ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"}," ignores ",{"tag":"a","children":["Difficult Terrain"],"href":"https://swse.miraheze.org/wiki/Difficult_Terrain"}," until the start of your next turn, and the ",{"tag":"a","children":["Vehicle Pilot"],"href":"https://swse.miraheze.org/wiki/Vehicle_Pilot","referenceId":"reference:4aff6d0e54fff36e"}," gains a +5 insight bonus on all ",{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"}," checks made to avoid ",{"tag":"a","children":["Hazards"],"href":"https://swse.miraheze.org/wiki/Hazards"}," and ",{"tag":"a","children":["Collisions"],"href":"https://swse.miraheze.org/wiki/Collisions","referenceId":"reference:38a01513f532d9ed"}," until the start of your next turn.\n"]},"\n",{"tag":"h3","children":["Quick Modifications"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"b","children":["Repairs on the Fly"]},", ",{"tag":"a","children":["Tech Specialist"],"href":"https://swse.miraheze.org/wiki/Tech_Specialist","referenceId":"reference:62e86e4173a4731b"},"\n"]},{"tag":"p","children":["When you create a ",{"tag":"a","children":["Field-Created Weapon"],"href":"https://swse.miraheze.org/wiki/Field-Created_Weapon"},", you can choose one weapon modification from the ",{"tag":"a","children":["Tech Specialist"],"href":"https://swse.miraheze.org/wiki/Tech_Specialist","referenceId":"reference:62e86e4173a4731b"}," feat to apply to the created weapon at the time of creation.\n"]},"\n",{"tag":"h3","children":["Repairs on the Fly"]},"\n",{"tag":"p","children":["You can use the ",{"tag":"a","children":["Repair"],"href":"https://swse.miraheze.org/wiki/Repair"}," application of the ",{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"}," skill as a ",{"tag":"a","children":["Standard Action"],"href":"https://swse.miraheze.org/wiki/Standard_Action"},". You can gain the benefits of this Talent only once per day per ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"},", ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"},", or object ",{"tag":"a","children":["Repaired"],"href":"https://swse.miraheze.org/wiki/Repaired"},".\n"]},"\n",{"tag":"h3","children":["Sabotage Device"]},"\n",{"tag":"p","children":["As a ",{"tag":"a","children":["Swift Action"],"href":"https://swse.miraheze.org/wiki/Swift_Action"},", you can sabotage any object or weapon that is powered by an ",{"tag":"a","children":["Energy Cell"],"href":"https://swse.miraheze.org/wiki/Energy_Cell","referenceId":"reference:a3dedb9c17e4ee9d"}," or ",{"tag":"a","children":["Power Pack"],"href":"https://swse.miraheze.org/wiki/Power_Pack","referenceId":"reference:2b783ab0537ca5d0"}," so that it becomes a ",{"tag":"a","children":["Grenade"],"href":"https://swse.miraheze.org/wiki/Grenade"},". The object or weapon is then considered to be a ",{"tag":"a","children":["Frag Grenade"],"href":"https://swse.miraheze.org/wiki/Frag_Grenade","referenceId":"reference:5d38df4b2da8b77e"}," in all ways, but it can be turned back into its original form with another ",{"tag":"a","children":["Swift Action"],"href":"https://swse.miraheze.org/wiki/Swift_Action"},".\n"]},"\n",{"tag":"h3","children":["Tech Savant"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Prerequisite:"]}," ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in ",{"tag":"a","children":["Knowledge (Technology)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Technology)"},"\n"]},{"tag":"p","children":["As a ",{"tag":"a","children":["Standard Action"],"href":"https://swse.miraheze.org/wiki/Standard_Action"},", you can increase the ",{"tag":"a","children":["Speed"],"href":"https://swse.miraheze.org/wiki/Speed","referenceId":"reference:c372fee9b4566b85"}," of one adjacent ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," or ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"}," that you occupy by 1 square (applied to any method of ",{"tag":"a","children":["Locomotion System"],"href":"https://swse.miraheze.org/wiki/Locomotion_System"},") until the end of your next turn. Any ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," or ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"}," can only benefit from this Talent once per round.\n"]},"\n",{"tag":"h3","children":["Vehicular Boost"]},"\n",{"tag":"p","children":["As a ",{"tag":"a","children":["Standard Action"],"href":"https://swse.miraheze.org/wiki/Standard_Action"},", you can make a DC 15 ",{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"}," check to grant one ",{"tag":"a","children":["Vehicle"],"href":"https://swse.miraheze.org/wiki/Vehicle"}," you occupy a number of ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," equal to 5 x your Class Level. Damage is subtracted from the ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," first, and any ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," remaining at the end of the encounter go away. ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," from multiple sources do not stack.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
