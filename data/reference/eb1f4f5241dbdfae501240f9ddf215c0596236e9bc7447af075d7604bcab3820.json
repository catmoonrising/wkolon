tack, and no damage if the attack misses.\n"]},{"tag":"p","children":[{"tag":"b","children":["Weapon Type:"]}," ",{"tag":"a","children":["Grenades"],"href":"https://swse.miraheze.org/wiki/Grenades","referenceId":"reference:0288f85b407ca487"},"\n"]},{"tag":"p","children":[{"tag":"b","children":["Size:"]}," Tiny\n"]},{"tag":"p","children":[{"tag":"b","children":["Cost:"]}," 500\n"]},{"tag":"p","children":[{"tag":"b","children":["Damage:"]}," 3d6\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Burst"],"href":"https://swse.miraheze.org/wiki/Burst"}," Radius:"]}," 2-Squares\n"]},{"tag":"p","children":[{"tag":"b","children":["Weight:"]}," 0.5 Kilograms\n"]},{"tag":"p","children":[{"tag":"b","children":["Type:"]}," Energy\n"]},{"tag":"p","children":[{"tag":"b","children":["Availability:"]}," ",{"tag":"a","children":["Restricted"],"href":"https://swse.miraheze.org/wiki/Restricted"},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
