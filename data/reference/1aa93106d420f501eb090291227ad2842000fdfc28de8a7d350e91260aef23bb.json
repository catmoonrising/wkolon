nging off his body. Vischera wants nothing more than to continue his experiments, and as such he will defend the facility to his death.\n"]},"\n",{"tag":"h2","children":["Captain Vischera Statistics (CL 2)"]},"\n",{"tag":"h4","children":["Normal"]},"\n",{"tag":"p","children":["Medium ",{"tag":"a","children":["Human"],"href":"https://swse.miraheze.org/wiki/Human","referenceId":"reference:9ffa865f2bc6e850"}," ",{"tag":"a","children":["Nonheroic"],"href":"https://swse.miraheze.org/wiki/Nonheroic","referenceId":"reference:1bca2ef1d9ebe1c3"}," 4/",{"tag":"a","children":["Noble"],"href":"https://swse.miraheze.org/wiki/Noble","referenceId":"reference:190d375ec3483f8f"}," 1\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"},":"]}," 1; ",{"tag":"b","children":[{"tag":"a","children":["Dark Side Score"],"href":"https://swse.miraheze.org/wiki/Dark_Side_Score"},":"]}," 3\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +3; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +7\n"]},{"tag":"p","children":[{"tag":"b","children":["Languages:"]}," Basic, Bocce, Durese, High Galactic, 2 Unassigned\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 17 (",{"tag":"a","children":["Flat-Footed"],"href":"https://swse.miraheze.org/wiki/Flat-Footed"},": 16), ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},": 11, ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},": 13\n"]},{"tag":"p","children":[{"tag":"a","children":["