ecurity personnel couldn't bring down the swoop gang leader, then maybe other professional hunters could take him out.\n"]},"\n",{"tag":"h2","children":["Blood Tach Units"]},"\n",{"tag":"h4","children":["Heroic Units"]},"\n",{"tag":"table","children":["\n",{"tag":"tbody","children":[{"tag":"tr","children":["\n",{"tag":"th","children":["NAME\n"]},"\n",{"tag":"th","children":["CHALLENGE LEVEL\n"]},"\n",{"tag":"th","children":["SOURCE\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":["Meekah Hozard"],"href":"https://swse.miraheze.org/wiki/Meekah_Hozard","referenceId":"reference:8d495998c7ec58f5"},"\n"]},"\n",{"tag":"td","children":["CL 10\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Web Enhancements"],"href":"https://swse.miraheze.org/wiki/Web_Enhancements"}]},"\n"]}]}]}]},"\n","\n",{"tag":"p","children":[{"tag":"br","children":[]},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
