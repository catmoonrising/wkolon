avenger's Guide to Droids"],"href":"https://swse.miraheze.org/wiki/Scavenger%27s_Guide_to_Droids"}]},"\n"]},{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"b","children":["Medical Programming"]},", ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in ",{"tag":"a","children":["Knowledge (Life Sciences)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Life_Sciences)"},"\n"]},{"tag":"p","children":["You use your medical knowledge and advanced processor to improve your treatment of medical conditions. When making a ",{"tag":"a","children":["Treat Injury"],"href":"https://swse.miraheze.org/wiki/Treat_Injury","referenceId":"reference:f1b9875c2302ce61"}," check to ",{"tag":"a","children":["Treat Disease"],"href":"https://swse.miraheze.org/wiki/Treat_Disease"},", ",{"tag":"a","children":["Treat Poison"],"href":"https://swse.miraheze.org/wiki/Treat_Poison"},", or ",{"tag":"a","children":["Treat Radiation"],"href":"https://swse.miraheze.org/wiki/Treat_Radiation"},", you can also add your ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," modifier to your roll.\n"]},"\n",{"tag":"h3","children":["Science Analyzer"]},"\n",{"tag":"p","children":[{"tag":"i","children":["Reference Book: ",{"tag":"a","children":["Scavenger's Guide to Droids"],"href":"https://swse.miraheze.org/wiki/Scavenger%27s_Guide_to_Droids"}]},"\n"]},{"tag":"p","children":[{"tag":"i","children":["Prerequisites:"]}," ",{"tag":"a","children":["Trained"],"href":"https://swse.miraheze.org/wiki/Trained"}," in ",{"tag":"a","children":["Knowledge (Life Sciences)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Life_Sciences)"}," and ",{"tag":"a","children":["Knowledge (Physical Sciences)"],"href":"https://swse.miraheze.org/wiki/Knowledge_(Physical_Sciences)"},"\n"]},{"tag":"p","children":["You use your extensive databanks to better analyze scientific data. You can add double your ",{"tag":"a","children"