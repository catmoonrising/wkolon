ildren":["TYPE\n"]},"\n",{"tag":"th","children":["SOURCE\n"]},"\n",{"tag":"th","children":["IMAGE\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":[{"tag":"i","children":["Predator"]},"-Class Starfighter"],"href":"https://swse.miraheze.org/wiki/Predator-Class_Starfighter","referenceId":"reference:a79aae02405191df"},"\n"]},"\n",{"tag":"td","children":["CL 11\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Starfighters"],"href":"https://swse.miraheze.org/wiki/Starfighters","referenceId":"reference:e127af2636e147fc"},"\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Starships of the Galaxy"],"href":"https://swse.miraheze.org/wiki/Starships_of_the_Galaxy"}]},"\n"]},"\n",{"tag":"td","children":["\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":[{"tag":"a","children":[{"tag":"i","children":["Sigma"]},"-Class Long-Range Shuttle"],"href":"https://swse.miraheze.org/wiki/Sigma-Class_Long-Range_Shuttle","referenceId":"reference:27d2960684cc2a53"},"\n"]},"\n",{"tag":"td","children":["CL 12\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Space Transports"],"href":"https://swse.miraheze.org/wiki/Space_Transports","referenceId":"reference:082a04e1f80578b3"},"\n"]},"\n",{"tag":"td","children":[{"tag":"i","children":[{"tag":"a","children":["Legacy Era Campaign Guide"],"href":"https://swse.miraheze.org/wiki/Legacy_Era_Campaign_Guide"}]},"\n"]},"\n",{"tag":"td","children":["\n"]}]}]}]},"\n","\n",{"tag":"p","children":[{"tag":"br","children":[]},"\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
