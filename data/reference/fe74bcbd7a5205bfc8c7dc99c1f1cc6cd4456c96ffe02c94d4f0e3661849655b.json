AAT/c_Gunships"},", but can sometimes be attached to the bottom of a ",{"tag":"a","children":[{"tag":"i","children":["Sentinel"]},"-Class Landing Craft"],"href":"https://swse.miraheze.org/wiki/Sentinel-Class_Landing_Craft","referenceId":"reference:de30aef2ced25f1e"}," if no ",{"tag":"a","children":["LAAT/c Gunships"],"href":"https://swse.miraheze.org/wiki/LAAT/c_Gunships"}," are available) and recovered the same way.\n"]},"\n",{"tag":"h4","children":["Default (Skilled)"]},"\n",{"tag":"h2","children":["PX-4 Mobile Command Base Statistics (CL 8)"]},"\n",{"tag":"p","children":["Gargantuan ",{"tag":"a","children":["Tracked Vehicle"],"href":"https://swse.miraheze.org/wiki/Tracked_Vehicle"},"\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +1; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +6\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 15 (",{"tag":"a","children":["Flat-Footed"],"href":"https://swse.miraheze.org/wiki/Flat-Footed"},": 15), ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},": 27; +10 Armor, ",{"tag":"a","children":["Vehicular Combat"],"href":"https://swse.miraheze.org/wiki/Vehicular_Combat","referenceId":"reference:31246426131b3457"},"\n"]},{"tag":"p","children":[{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},": 270; ",{"tag":"a","children":["Damage Reduction"],"href":"https://swse.miraheze.org/wiki/Damage_Reduction"},": 15; ",{"tag":"a","children":["Damage Threshold"],"href":"https://swse.miraheze.org/wiki/Damage_Threshold"}