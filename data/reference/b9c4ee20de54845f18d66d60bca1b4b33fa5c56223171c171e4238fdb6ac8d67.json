":"h3","children":["Abilities"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Strength"],"href":"https://swse.miraheze.org/wiki/Strength"},": 62, ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"},": 18, ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"},": -, ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"},": 18\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"},":"]}," ",{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"}," +0, ",{"tag":"a","children":["Mechanics"],"href":"https://swse.miraheze.org/wiki/Mechanics","referenceId":"reference:1c74a0e2ceaaeb28"}," +6, ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +6, ",{"tag":"a","children":["Pilot"],"href":"https://swse.miraheze.org/wiki/Pilot","referenceId":"reference:383e2d946278a872"}," +0, ",{"tag":"a","children":["Use Computer"],"href":"https://swse.miraheze.org/wiki/Use_Computer","referenceId":"reference:ff8449006aafd27d"}," +6\n"]},"\n",{"tag":"h3","children":["Ship Statistics"]},"\n",{"tag":"p","children":[{"tag":"b","children":["Crew:"]}," 80 (Skilled ",{"tag":"a","children":["Crew Quality"],"href":"https://swse.miraheze.org/wiki/Crew_Quality","referenceId":"reference:c79e9b6530a86284"},"); ",{"tag":"b","children":["Passengers:"]}," None\n"]},{"tag":"p","children":[{"tag":"b","children":["Cargo:"]}," 3,600 Tons; ",{"tag":"b","children":["Consumables:"]}," 1 Year; ",{"tag":"b","children":["Carried Craft:"]}," None\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Hyperdrive"],"href":"https://swse.miraheze.org/wiki/Hyperdrive","referenceId":"reference:6774bf610b6e6