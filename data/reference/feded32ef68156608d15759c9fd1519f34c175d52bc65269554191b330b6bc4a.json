n"]},"\n",{"tag":"td","children":["+2\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["15th\n"]},"\n",{"tag":"td","children":["105,000\n"]},"\n",{"tag":"td","children":["+15\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["6th\n"]},"\n",{"tag":"td","children":["15,000\n"]},"\n",{"tag":"td","children":["+6\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},"\n"]},"\n",{"tag":"td","children":["16th\n"]},"\n",{"tag":"td","children":["120,000\n"]},"\n",{"tag":"td","children":["+16\n"]},"\n",{"tag":"td","children":["+8\n"]},"\n",{"tag":"td","children":["Ability Score Improvement\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["7th\n"]},"\n",{"tag":"td","children":["21,000\n"]},"\n",{"tag":"td","children":["+7\n"]},"\n",{"tag":"td","children":["+3\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["17th\n"]},"\n",{"tag":"td","children":["136,000\n"]},"\n",{"tag":"td","children":["+17\n"]},"\n",{"tag":"td","children":["+8\n"]},"\n",{"tag":"td","children":["-\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["8th\n"]},"\n",{"tag":"td","children":["28,000\n"]},"\n",{"tag":"td","children":["+8\n"]},"\n",{"tag":"td","children":["+4\n"]},"\n",{"tag":"td","children":["Ability Score Improvement\n"]},"\n",{"tag":"td","children":["18th\n"]},"\n",{"tag":"td","children":["153,000\n"]},"\n",{"tag":"td","children":["+18\n"]},"\n",{"tag":"td","children":["+9\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["9th\n"]},"\n",{"tag":"td","children":["36,000\n"]},"\n",{"tag":"td","children":["+9\n"]},"\n",{"tag":"td","children":["+4\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},"\n"]},"\n",{"tag":"td","children":["19th\n"]},"\n",{"tag":"td","children":["171,000\n"]},"\n",{"tag":"td","children":["+19\n"]},"\n",{"tag":"td","children":["+9\n"]},"\n",{"tag":"td","children":["-\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["45,000\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":["-\n"]},"\n",{"tag":"td","children":["20th\n"]},"\n",{"tag":"td","children":["190,000\n"]},"\n",{"tag":"td","children":["+20\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Ability Score Improvement\n"]}]}]}]},"\n",{"tag":"h3","children":["Acquiring Feats"]},"\n",{"tag":"p","children":["Each character gets one ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"}," when the character is created (at 1st level). At 3rd, 6th, 9th, 12th, 15th, and 18th level, characters gain another ",{"tag":"a","children":["Feat"],"href":"https://swse.miraheze.org/wiki/Feat"},". These ",{"tag":"a","children":["Feats"],"href":"https://swse.miraheze.org/wiki/Feats","referenceId":"reference:9194ccf56b9cace0"}," are not related to Class Bonus Feats, and are tied to a hero's Character Level, not their Class Level.\n"]},"\n",{"tag":"h3","children":["Ability Score Improvements"]},"\n",{"tag":"p","children":["At 4th, 8th, 12th, 16th, and 20th level, a heroic character increases two ",{"tag":"a","children":["Ability Scores"],"href":"https://swse.miraheze.org/wiki/Ability_Scores"}," by 1 point each.\n"]},{"tag":"p","children":["When an Ability Score changes, all attributes associated with that score change accordingly. For example, when Sia-Lan becomes a 4th level ",{"tag":"a","children":["Jedi"],"href":"https://swse.miraheze.org/wiki/Jedi","referenceId":"reference:0b0e48747027a29d"},", she increases her ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"}," from 15 to 16 and increases her ",{"tag":"a","children":["Charisma"],"href":"https://swse.miraheze.org/wiki/Charisma"}," from 13 to 14. Now she's harder to hit, better at using ranged weapons, and all of her ",{"tag":"a","children":["Dexterity"],"href":"https://swse.miraheze.org/wiki/Dexterity"},"- and ",{"tag":"a","children":["Charisma"],"href":"https://swse.miraheze.org/wiki/Charisma"},"-based ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," improve as well.\n"]},{"tag":"p","children":[{"tag":"a","children":["Ability Score"],"href":"https://swse.miraheze.org/wiki/Ability_Score"}," increases are retroactive. For example, if you increase your ",{"tag":"a","children":["Intelligence"],"href":"https://swse.miraheze.org/wiki/Intelligence"}," score from 13 to 14, you immediately gain an additional ",{"tag":"a","children":["Trained Skill"],"href":"https://swse.miraheze.org/wiki/Trained_Skill"}," chosen from your class ",{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"}," and an additional ",{"tag":"a","children":["Language"],"href":"https://swse.miraheze.org/wiki/Language"},". Similarly, if a ",{"tag":"a","children":["Jedi"],"href":"https://swse.miraheze.org/wiki/Jedi","referenceId":"reference:0b0e48747027a29d"}," who with two instances of the ",{"tag":"a","children":["Force Training"],"href":"https://swse.miraheze.org/wiki/Force_Training","referenceId":"reference:24f2c1df8e62fd15"}," feat increased their ",{"tag":"a","children":["Wisdom"],"href":"https://swse.miraheze.org/wiki/Wisdom"}," from 13 to 14, they would gain two ",{"tag":"a","children":["Force Powers"],"href":"https://swse.miraheze.org/wiki/Force_Powers","referenceId":"reference:85acec94cd1ca5f3"}," (for a total of six).\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
