ki/Droid"},". Anyone ",{"tag":"a","children":["Eavesdropping"],"href":"https://swse.miraheze.org/wiki/Eavesdropping"}," or reviewing recordings of targets protected by an Interference Generator must make a DC 30 ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," or ",{"tag":"a","children":["Use Computer"],"href":"https://swse.miraheze.org/wiki/Use_Computer","referenceId":"reference:ff8449006aafd27d"}," check to pick up even scattered words and phrases.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
