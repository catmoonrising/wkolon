y"],"href":"https://swse.miraheze.org/wiki/Force_Sensitivity","referenceId":"reference:5202cab02f367bcf"},", ",{"tag":"a","children":["Force Training"],"href":"https://swse.miraheze.org/wiki/Force_Training","referenceId":"reference:24f2c1df8e62fd15"},", ",{"tag":"a","children":["Improved Defenses"],"href":"https://swse.miraheze.org/wiki/Improved_Defenses","referenceId":"reference:bae4534e5fb194c7"},"\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Skills"],"href":"https://swse.miraheze.org/wiki/Skills","referenceId":"reference:66d0f523a379b2de"},":"]}," ",{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"}," +8 (may reroll, must take second result), ",{"tag":"a","children":["Stealth"],"href":"https://swse.miraheze.org/wiki/Stealth","referenceId":"reference:526a40a447ddd7aa"}," +8, ",{"tag":"a","children":["Use the Force"],"href":"https://swse.miraheze.org/wiki/Use_the_Force","referenceId":"reference:74883d1dd46b87fe"}," +8\n"]},"\n",{"tag":"h3","children":["Special Qualities"]},"\n",{"tag":"p","children":[{"tag":"b","children":["Consume Force:"]}," Whenever a Derriphan is targeted by a ",{"tag":"a","children":["Force Power"],"href":"https://swse.miraheze.org/wiki/Force_Power"}," without the [",{"tag":"i","children":[{"tag":"a","children":["Light Side"],"href":"https://swse.miraheze.org/wiki/Light_Side"}]},"] descriptor, the Derriphan immediately regains one spent ",{"tag":"a","children":["Force Power"],"href":"https://swse.miraheze.org/wiki/Force_Power"}," as a ",{"tag":"a","children":["Reaction"],"href":"https://swse.miraheze.org/wiki/Reaction"},".\n"]},{"tag":"p","children":[{"tag":"b","children":["Dark Backlash:"]}," Whenever a Derriphan is targeted by a ",{"tag":"a","children":["Force Power"],"href":"https://swse.miraheze.org/wiki/Force_Power"}," with the [",{"tag":"i","children":[{"tag":"a","children":["Mind-Affecting"],"href":"https://swse.miraheze.org/wiki/Mind-Affecting"}]},"] descriptor, the creature activating that ",{"tag":"a","children":["Force Power"],"href":"https://swse.miraheze.org/wiki/Force_Power"}," immediately takes 3d8 points of ",{"tag":"a","children":["Force"],"href":"https://swse.miraheze.org/wiki/Force"}," damage.\n"]},{"tag":"p","children":[{"tag":"b","children":["Possession:"]}," As a ",{"tag":"a","children":["Standard Action"],"href":"https://swse.miraheze.org/wiki/Standard_Action"},", a Derriphan can attempt to possess the body of an adjacent creature. The Derriphan makes an attack (1d20+9) against the ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"}," of the target; if the attack succeeds, the Derriphan enters the target's body.\n"]},{"tag":"p","children":["Once inside, the Derriphan cannot be targeted by attacks or skill checks. Each round on its turn, the Derriphan makes a single attack (1d20+9) against the possessed creature's ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},"; a successful attack deals 3d8 points of ",{"tag":"a","children":["Force"],"href":"https://swse.miraheze.org/wiki/Force"}," damage to the target, and a failed attack deals half damage. If the target is reduced to 0 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," by this attack, the Derriphan seizes mental control of the creature, restoring it to full ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},".\n"]},{"tag":"p","children":["While the Derriphan possesses a creature, the Derriphan controls all of its ",{"tag":"a","children":["Actions"],"href":"https://swse.miraheze.org/wiki/Actions","referenceId":"reference:ff8059dc6752afdd"},". The Derriphan-possessed creature has access to the Derriphan's ",{"tag":"a","children":["Force Power Suite"],"href":"https://swse.miraheze.org/wiki/Force_Power_Suite"}," in addition to its own. The Derriphan uses whichever ",{"tag":"a","children":["Use the Force"],"href":"https://swse.miraheze.org/wiki/Use_the_Force","referenceId":"reference:74883d1dd46b87fe"}," skill bonus is higher, either its bonus or its host's bonus, and the Derriphan-possessed creature's ",{"tag":"a","children":["Dark Side Score"],"href":"https://swse.miraheze.org/wiki/Dark_Side_Score"}," equals its ",{"tag":"a","children":["Wisdom"],"href":"https://swse.miraheze.org/wiki/Wisdom"}," score for as long as it is possessed.\n"]},{"tag":"p","children":["If a Derriphan-possessed creature is reduced to 0 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},", the Derriphan exits that body as a ",{"tag":"a","children":["Reaction"],"href":"https://swse.miraheze.org/wiki/Reaction"},", appearing in an adjacent square of its choosing.\n"]},"\n",{"tag":"h4","children":["-1 Condition"]},"\n",{"tag":"p","children":["Tiny Airborne ",{"tag":"a","children":["Beast"],"href":"https://swse.miraheze.org/wiki/Beast","referenceId":"reference:628bf77a740094a9"}," 8\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Dark Side Score"],"href":"https://swse.miraheze.org/wiki/Dark_Side_Score"},":"]}," 16\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +7; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Darkvision"],"href":"https://swse.miraheze.org/wiki/Darkvision"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +6\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 16 ("