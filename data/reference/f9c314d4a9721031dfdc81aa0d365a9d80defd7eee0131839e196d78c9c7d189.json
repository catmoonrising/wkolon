c755980354c02b"}," for the potential threat he had brought to the station. The customs officers left the Vindinax in Cargo Bay 2, not suspecting that it could break out of its shipping container.\n"]},"\n",{"tag":"h2","children":["Vindinax Statistics (CL 5)"]},"\n",{"tag":"h4","children":["Normal"]},"\n",{"tag":"p","children":["Medium ",{"tag":"a","children":["Beast"],"href":"https://swse.miraheze.org/wiki/Beast","referenceId":"reference:628bf77a740094a9"}," 6\n"]},{"tag":"p","children":[{"tag":"b","children":[{"tag":"a","children":["Initiative"],"href":"https://swse.miraheze.org/wiki/Initiative","referenceId":"reference:3e687de48a6ad4e5"},":"]}," +5; ",{"tag":"b","children":["Senses:"]}," ",{"tag":"a","children":["Low-Light Vision"],"href":"https://swse.miraheze.org/wiki/Low-Light_Vision"},", ",{"tag":"a","children":["Perception"],"href":"https://swse.miraheze.org/wiki/Perception","referenceId":"reference:bd18e320a6bb9f53"}," +10\n"]},"\n",{"tag":"h3","children":["Defenses"]},"\n",{"tag":"p","children":[{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},": 16 (",{"tag":"a","children":["Flat-Footed"],"href":"https://swse.miraheze.org/wiki/Flat-Footed"},": 14), ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},": 13, ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},": 12\n"]},{"tag":"p","children":[{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},": 53; ",{"tag":"a","children":["Damage Threshold"],"href":"https://swse.miraheze.org/wiki/Damage_Threshold"},": 13\n"]},"\n",{"tag":"h3","children":["Offense"]},"\n",{"tag":"p","children":[{"tag":"b","children":["Speed:"]}," 6 Squares\n"]},{"tag":"p","children":[{"tag":"b","children":["Melee:"]}," Bite +7* (1d6+8)\n"]},{"tag":"p","children":[{"tag":"b","children":["Melee:"]}," Claws (2) +7* (1d4+8)