n":["9th\n"]},"\n",{"tag":"td","children":["+9\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Droid Commander Talent"],"href":"https://swse.miraheze.org/wiki/Droid_Commander_Talent"},"\n"]}]},"\n",{"tag":"tr","children":["\n",{"tag":"td","children":["5th\n"]},"\n",{"tag":"td","children":["+5\n"]},"\n",{"tag":"td","children":[{"tag":"a","children":["Droid Commander Talent"],"href":"https://swse.miraheze.org/wiki/Droid_Commander_Talent"},"\n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Networked Mind (5 Droid Allies)\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Droid Commanders gain a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},", and ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Droid Commanders gain 1d10 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Droid Commanders gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, every time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Droid Commander gains an additional ",{"tag":"a","children":["Droid Commander Talent"],"href":"https://swse.miraheze.org/wiki/Droid_Commander_Talent"},". A Droid Commander may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Droid Commander Talent Trees"],"href":"https://swse.miraheze.org/wiki/Droid_Commander_Talent_Trees","referenceId":"reference:30d8c9a002c9a686"}," they wish (or ",{"tag":"a","children":["Droid Talents"],"href":"https://swse.miraheze.org/wiki/Droid_Talents"}," from their ",{"tag":"a","children":["Droid Degree"],"href":"https://swse.miraheze.org/wiki/Droid_Degree"},"), but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Networked Mind"]},"\n",{"tag":"p","children":["A Droid Commander can designate a number of its Droid Allies equal to one-half its Class Level as being networked with it. A Networked Droid Ally can receive beneficial Mind-Affecting effects from the Droid Commander. Once the Droid Commander designates a Droid Ally as the recipient of this benefit, it cannot change the ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," beneficiary until after the end of the encounter, and designating a ",{"tag":"a","children":["Droid"],"href":"https://swse.miraheze.org/wiki/Droid"}," to benefit from this Class Feature is a ",{"tag":"a","children":["Free Action"],"href":"https://swse.miraheze.org/wiki/Free_Action"},".\n"]},{"tag":"p","children":["Additionally, the Droid Commander is considered to have ",{"tag":"a","children":["Line of Sight"],"href":"https://swse.miraheze.org/wiki/Line_of_Sight","referenceId":"reference:7ae5eaf79143552f"}," to a Networked Droid Ally as long as they both have an active ",{"tag":"a","children":["Comlink"],"href":"https://swse.miraheze.org/wiki/Comlink","referenceId":"reference:609e72c37493843f"}," (if the ",{"tag":"a","children":["Comlinks"],"href":"https://swse.miraheze.org/wiki/Comlinks"}," are subject to communications jamming, it loses this benefit).\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
