th\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Unflinching (5/Encounter)\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Gladiators gain a +4 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", and a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Gladiators gain 1d10 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Gladiators gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, each time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Gladiator gains an additional ",{"tag":"a","children":["Gladiator Talent"],"href":"https://swse.miraheze.org/wiki/Gladiator_Talent"},". A Gladiator may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Gladiator Talent Trees"],"href":"https://swse.miraheze.org/wiki/Gladiator_Talent_Trees","referenceId":"reference:cae20a472b964174"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Unflinching"]},"\n",{"tag":"p","children":["At 2nd level your training as a Gladiator has made you very difficult to intimidate or deter. For a number of times equal to half your Gladiator level (rounded down) per encounter, you may add your Gladiator level to either your ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"}," (and ",{"tag":"a","children":["Damage Threshold"],"href":"https://swse.miraheze.org/wiki/Damage_Threshold"},"), or ",{"tag":"a","children":["Will Defense"],"href":"https://swse.miraheze.org/wiki/Will_Defense"}," until the start of your next turn as a ",{"tag":"a","children":["Reaction"],"href":"https://swse.miraheze.org/wiki/Reaction"},"; you can choose which ",{"tag":"a","children":["Defense"],"href":"https://swse.miraheze.org/wiki/Defense"}," to apply the bonus to when you use the ability, but you must declare the use of this feature before you know the outcome of the effect targeting you.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
