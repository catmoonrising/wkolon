children":[{"tag":"a","children":["Martial Arts Master Talent"],"href":"https://swse.miraheze.org/wiki/Martial_Arts_Master_Talent"},"\n"]},"\n",{"tag":"td","children":["10th\n"]},"\n",{"tag":"td","children":["+10\n"]},"\n",{"tag":"td","children":["Tough as Durasteel (10 ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"},")\n"]}]}]}]},"\n",{"tag":"h3","children":["Class Features"]},"\n",{"tag":"ul","children":[{"tag":"li","children":[{"tag":"b","children":["Defense Bonuses:"]}," At 1st level, Martial Arts Masters gain a +2 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Reflex Defense"],"href":"https://swse.miraheze.org/wiki/Reflex_Defense"},", and a +4 ",{"tag":"a","children":["Class"],"href":"https://swse.miraheze.org/wiki/Class"}," bonus to their ",{"tag":"a","children":["Fortitude Defense"],"href":"https://swse.miraheze.org/wiki/Fortitude_Defense"},"."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Hit Points:"]}," At each level, Martial Arts Masters gain 1d10 ",{"tag":"a","children":["Hit Points"],"href":"https://swse.miraheze.org/wiki/Hit_Points","referenceId":"reference:58e8ee2c9538d027"}," + their ",{"tag":"a","children":["Constitution"],"href":"https://swse.miraheze.org/wiki/Constitution"}," modifier."]},"\n",{"tag":"li","children":[{"tag":"b","children":["Force Points:"]}," Martial Arts Masters gain a number of ",{"tag":"a","children":["Force Points"],"href":"https://swse.miraheze.org/wiki/Force_Points"}," equal to 6 + one-half their Character Level, rounded down, each time they gain a new level in this ",{"tag":"a","children":["Prestige Class"],"href":"https://swse.miraheze.org/wiki/Prestige_Class"},"."]}]},"\n",{"tag":"h3","children":["Talents"]},"\n",{"tag":"p","children":["At every odd-numbered level (1st, 3rd, 5th, and so on), a Martial Arts Master gains an additional ",{"tag":"a","children":["Martial Arts Master Talent"],"href":"https://swse.miraheze.org/wiki/Martial_Arts_Master_Talent"},". A Martial Arts Master may choose a ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," from any of the ",{"tag":"a","children":["Martial Arts Master Talent Trees"],"href":"https://swse.miraheze.org/wiki/Martial_Arts_Master_Talent_Trees","referenceId":"reference:98327fa075d1e758"}," they wish, but they must meet the prerequisites (if any) of the chosen ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"},". No ",{"tag":"a","children":["Talent"],"href":"https://swse.miraheze.org/wiki/Talent"}," can be selected more than once unless expressly indicated.\n"]},"\n",{"tag":"h3","children":["Tough as Durasteel"]},"\n",{"tag":"p","children":["At 2nd level as part of their training, a Martial Arts Master learned how to ready themselves for the attacks, reducing the effectiveness of the attacker's blows. Whenever a Martial Arts Master damages a target with an ",{"tag":"a","children":["Unarmed Attack"],"href":"https://swse.miraheze.org/wiki/Unarmed_Attack"}," while wearing ",{"tag":"a","children":["Light Armor"],"href":"https://swse.miraheze.org/wiki/Light_Armor","referenceId":"reference:1b329ddc8a34adfe"}," or no ",{"tag":"a","children":["Armor"],"href":"https://swse.miraheze.org/wiki/Armor"},", they gain ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," equal to their Class Level. The number of ",{"tag":"a","children":["Bonus Hit Points"],"href":"https://swse.miraheze.org/wiki/Bonus_Hit_Points"}," gained with an ",{"tag":"a","children":["Unarmed Attack"],"href":"https://swse.miraheze.org/wiki/Unarmed_Attack"}," increases for every other level you gain in this Prestige Class.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
