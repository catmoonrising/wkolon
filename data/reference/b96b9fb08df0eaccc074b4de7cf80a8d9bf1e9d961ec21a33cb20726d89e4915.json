ildren":["Swift Actions"],"href":"https://swse.miraheze.org/wiki/Swift_Actions"}," to deactivate a locked ",{"tag":"a","children":["Lightsaber"],"href":"https://swse.miraheze.org/wiki/Lightsaber","referenceId":"reference:987a817de9003439"}," blade.\n"]},"\n","\n","\n","\n\n","\n\n","\n"]}}
