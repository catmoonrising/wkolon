{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wkolon rules pack v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "license",
    "sources",
    "rules",
    "species",
    "classes",
    "skills",
    "feats",
    "talents",
    "equipment"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "license": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "revision",
          "url",
          "history",
          "timestamp"
        ]
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "combat": {
          "type": "object",
          "required": [
            "sourceIds",
            "shieldLoss",
            "shieldRecharge",
            "rechargeDC",
            "rechargeActions",
            "naturalHit",
            "naturalMiss",
            "criticalMultiplier",
            "minimumDamage"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "shieldLoss": {
              "type": "integer",
              "minimum": 1
            },
            "shieldRecharge": {
              "type": "integer",
              "minimum": 1
            },
            "rechargeDC": {
              "type": "integer",
              "minimum": 1
            },
            "rechargeActions": {
              "type": "integer",
              "minimum": 1
            },
            "naturalHit": {
              "type": "integer",
              "minimum": 1
            },
            "naturalMiss": {
              "type": "integer",
              "minimum": 1
            },
            "criticalMultiplier": {
              "type": "integer",
              "minimum": 1
            },
            "minimumDamage": {
              "type": "integer",
              "minimum": 1
            },
            "areaSourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "areaMinimumRoll": {
              "const": 10
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "sourceIds",
            "forcePointBase",
            "xpStep"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "forcePointBase": {
              "type": "integer",
              "minimum": 0
            },
            "xpStep": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sizeStealth": {
          "type": "object",
          "required": [
            "small",
            "medium",
            "large"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        },
        "licensing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "ratings"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "ratings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "licensed",
                "restricted",
                "military",
                "illegal"
              ],
              "properties": {
                "licensed": {
                  "$ref": "#/$defs/licenseRating"
                },
                "restricted": {
                  "$ref": "#/$defs/licenseRating"
                },
                "military": {
                  "$ref": "#/$defs/licenseRating"
                },
                "illegal": {
                  "$ref": "#/$defs/licenseRating"
                }
              }
            }
          }
        },
        "counselingApplications": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "talent-activation",
              "weapon-familiarity",
              "partial-proficiency",
              "raw-equivalent",
              "range-penalties",
              "unarmed-proficiency",
              "unarmed-finesse",
              "second-winds",
              "second-wind-exhaustion"
            ]
          }
        },
        "armorMovement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "speedMultipliers",
            "runMultipliers",
            "droidHeavySlowedSpeeds"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "speedMultipliers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light",
                "medium",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "medium": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "heavy": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "runMultipliers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light",
                "medium",
                "heavy"
              ],
              "properties": {
                "light": {
                  "type": "integer",
                  "minimum": 1
                },
                "medium": {
                  "type": "integer",
                  "minimum": 1
                },
                "heavy": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "droidHeavySlowedSpeeds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        },
        "forceTalentAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trees",
            "sourceIds"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "trees": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "tree:alter",
                  "tree:control",
                  "tree:dark-side",
                  "tree:sense"
                ]
              }
            }
          }
        },
        "forcePowerRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "restMinutes",
            "forcePointCost",
            "naturalRoll"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "restMinutes": {
              "const": 1
            },
            "forcePointCost": {
              "const": 1
            },
            "naturalRoll": {
              "const": 20
            }
          }
        },
        "weaponRanges": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "penalties",
            "limits"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "penalties": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "unarmed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "damage",
            "dieSteps"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "damage": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^1d[0-9]+$"
              }
            },
            "dieSteps": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "secondWind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "hitPointFraction",
            "maximumHitPointFraction",
            "dailyUses",
            "usesPerEncounter",
            "multipleUsesTopic",
            "exhaustionTopic",
            "exhaustionRestHours",
            "forceRecovery"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "hitPointFraction": {
              "const": 0.25
            },
            "maximumHitPointFraction": {
              "const": 0.5
            },
            "dailyUses": {
              "const": 1
            },
            "usesPerEncounter": {
              "const": 1
            },
            "multipleUsesTopic": {
              "const": "jc:114-variant-rule-multiple-second-winds"
            },
            "exhaustionTopic": {
              "const": "jc:114-optional-rule-the-edge-of-exhaustion"
            },
            "exhaustionRestHours": {
              "const": 8
            },
            "forceRecovery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "talentId",
                "die",
                "maxDice"
              ],
              "properties": {
                "talentId": {
                  "const": "talent:force-recovery"
                },
                "die": {
                  "const": 6
                },
                "maxDice": {
                  "const": 10
                }
              }
            }
          }
        },
        "encumbrance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "heavyFraction",
            "liftFraction",
            "strainFraction",
            "speedMultiplier",
            "runMultiplier",
            "skillPenalty",
            "skills",
            "sizeMultipliers"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "skills": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^skill:[a-z0-9-]+$"
              }
            },
            "sizeMultipliers": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "heavyFraction": {
              "const": 0.25
            },
            "liftFraction": {
              "const": 0.5
            },
            "strainFraction": {
              "const": 1
            },
            "speedMultiplier": {
              "const": 0.75
            },
            "runMultiplier": {
              "const": 3
            },
            "skillPenalty": {
              "const": -10
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "swiftActions"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "swiftActions": {
              "const": 3
            }
          }
        },
        "naturalHealing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "restHours",
            "usesPerDay",
            "removablePersistent"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "restHours": {
              "const": 8
            },
            "usesPerDay": {
              "const": 1
            },
            "removablePersistent": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "rage",
                  "second-wind",
                  "injury"
                ]
              }
            }
          }
        },
        "unconsciousRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "dc",
            "firstMinutes",
            "retryHours",
            "deathFailureMargin",
            "fatalNatural"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dc": {
              "const": 10
            },
            "firstMinutes": {
              "const": 1
            },
            "retryHours": {
              "const": 1
            },
            "deathFailureMargin": {
              "const": 5
            },
            "fatalNatural": {
              "const": 1
            },
            "stunNoFatalCheck": {
              "const": true
            }
          }
        },
        "weaponAccessories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "scopeRangeReduction",
            "rifleOneHandedPenalty",
            "carefulShotBonus",
            "deadeyeDice"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "scopeRangeReduction": {
              "const": 1
            },
            "rifleOneHandedPenalty": {
              "const": -5
            },
            "carefulShotBonus": {
              "const": 1
            },
            "deadeyeDice": {
              "const": 1
            }
          }
        },
        "ammunition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "autofireShots"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "autofireShots": {
              "const": 10
            }
          }
        },
        "incomingDamage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIds",
            "normalThresholdSteps",
            "helplessStep",
            "forcePointCost",
            "stun",
            "ion"
          ],
          "properties": {
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "normalThresholdSteps": {
              "const": 1
            },
            "helplessStep": {
              "const": 5
            },
            "forcePointCost": {
              "const": 1
            },
            "stun": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hpDivisor",
                "thresholdSteps",
                "blasterRange"
              ],
              "properties": {
                "hpDivisor": {
                  "const": 2
                },
                "thresholdSteps": {
                  "const": 2
                },
                "blasterRange": {
                  "const": 6
                }
              }
            },
            "ion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hpDivisor",
                "thresholdSteps"
              ],
              "properties": {
                "hpDivisor": {
                  "const": 2
                },
                "thresholdSteps": {
                  "const": 2
                }
              }
            }
          }
        }
      },
      "required": [
        "combat",
        "resources",
        "sizeStealth",
        "armorMovement"
      ]
    },
    "species": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/species"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "feats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "talents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipment"
      }
    },
    "destinies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/background"
      }
    },
    "heroicTraits": {
      "type": "object",
      "required": [
        "sourceIds",
        "eras",
        "heroTypes"
      ],
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heroTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rulePages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "book",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "book": {
          "const": "Core Rulebook"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogRecord"
          }
        }
      }
    },
    "jediCounseling": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "issue",
          "sourceId",
          "ruleId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^jc:[0-9]+-[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "issue": {
            "type": "integer",
            "minimum": 105,
            "maximum": 115
          },
          "sourceId": {
            "type": "string"
          },
          "ruleId": {
            "type": "string"
          }
        }
      }
    },
    "forcePowers": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          }
        ],
        "required": [
          "action",
          "descriptors"
        ],
        "properties": {
          "action": {
            "enum": [
              "standard-action",
              "swift-action",
              "full-round-action",
              "free-action",
              "reaction"
            ]
          },
          "descriptors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "dark-side",
                "light-side",
                "mind-affecting",
                "telekinetic"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "background": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        }
      ],
      "required": [
        "category",
        "relevantSkills",
        "skillChoices",
        "bonusLanguages",
        "untrainedBonus",
        "excludedSpecies"
      ],
      "properties": {
        "category": {
          "enum": [
            "event",
            "occupation",
            "planet"
          ]
        },
        "relevantSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "skillChoices": {
          "enum": [
            1,
            2
          ]
        },
        "untrainedBonus": {
          "enum": [
            0,
            2
          ]
        },
        "bonusLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedSpecies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditionalFocus": {
          "type": "string"
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "name",
        "sourceId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+:[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        },
        "reference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "article": {
          "$ref": "#/$defs/article"
        },
        "talentAccessSourceId": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "heading",
        "text",
        "sourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      }
    },
    "article": {
      "type": "object",
      "required": [
        "sourceId",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wikiNode"
          }
        }
      }
    },
    "wikiNode": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "tag",
            "children"
          ],
          "additionalProperties": false,
          "properties": {
            "tag": {
              "enum": [
                "p",
                "b",
                "i",
                "strong",
                "em",
                "ul",
                "ol",
                "li",
                "dl",
                "dt",
                "dd",
                "table",
                "thead",
                "tbody",
                "tr",
                "th",
                "td",
                "caption",
                "h2",
                "h3",
                "h4",
                "h5",
                "br",
                "sub",
                "sup",
                "blockquote",
                "hr",
                "a"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/wikiNode"
              }
            },
            "href": {
              "type": "string",
              "pattern": "^https://swse\\.miraheze\\.org/wiki/"
            },
            "ruleId": {
              "type": "string",
              "pattern": "^rule:[a-z0-9-]+$"
            },
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        }
      ]
    },
    "catalogRecord": {
